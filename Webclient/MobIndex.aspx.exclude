<%@ Page Language="C#" AutoEventWireup="true" CodeFile="MobIndex.aspx.cs" Inherits="MobIndex" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width" />
    <title>Verve Mobile App</title>
    <link href="css/mainmobile.css" type="text/css" rel="stylesheet" />
</head>
<body>
    <div class="head">
        <%--<a href="" class="back">
            <img src="MobImages/btn-back.png"></a>--%>
        <%--<a href="" class="logout">
            <img src="MobImages/Logout_icon.png"></a>--%>
        <h1>
            <label>Welcome</label>&nbsp;<span><asp:Label runat="server" ID="lblUserName" Text=""></asp:Label></span>  </h1>
    </div>
    <div class="absPoint">
        <h1>
            <asp:Label ID="lblClosingmile" runat="server" Text="0"></asp:Label></h1>
        <p>Reward Points</p>
    </div>
    <div class="pointDetail">
        <ul class="earnP">
            <li class="txtHead">Earned Points</li>
            <li>Bonus Points 
                <p>
                    <asp:Label ID="lblBonusmile" runat="server" Text="0"></asp:Label>
                </p>
            </li>
            <li>Spend Points 
                <p>
                    <asp:Label ID="lblSpendmile" runat="server" Text="0"></asp:Label>
                </p>
            </li>
            <li>Purchased Points 
                <p>
                    <asp:Label ID="lblPurchasemile" runat="server" Text="0"></asp:Label>
                </p>
            </li>
            <li>Partner Points 
                <p>
                    <asp:Label ID="lblPartnermile" runat="server" Text="0"></asp:Label>
                </p>
            </li>
            <li class="txtHead">Redeemed Points</li>
            <li>Redeemed Points 
                <p>
                    <asp:Label ID="lblRedeemedmile" runat="server" Text="0"></asp:Label>
                </p>
            </li>
        </ul>
        <h2>Redeem your Points</h2>
        <ul class="redeemP">
            <li><a href="Index.aspx?id=1">
                <img src="MobImages/Bookticket_icon.png"><p>Book a Ticket</p>
            </a></li>
            <li><a href="Index.aspx?id=2">
                <img src="MobImages/Bookhotel_icon.png"><p>Book a Hotel</p>
            </a></li>
            <li><a href="Index.aspx?id=3">
                <img src="MobImages/Rentcar_icon.png"><p>Rent a Car</p>
            </a></li>
            <li><a href="Shop/Shop.aspx">
                <img src="MobImages/Shopping_icon.png"><p>Shopping Online</p>
            </a></li>
             <li><a href="Giftcards.aspx">
                <img src="MobImages/hadiyati-icon.png"><p>Redeem Partners</p>
            </a></li>
              <li><a href="PrepaidCard.aspx">
                <img src="MobImages/Bookvoucher_icon.png"><p style="padding:1px 0 0">Hadiyati Card</p>
            </a></li>
            <li class="IcnCenter"><a href="StatementSummary.aspx">
                <img src="MobImages/myaccount_icon.png"><p>My Account</p>
            </a></li>

        </ul>
    </div>
</body>
</html>
