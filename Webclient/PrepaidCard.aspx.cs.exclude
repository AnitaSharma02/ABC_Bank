            }
        }
    }

    private static string Encrypt(string clearText)
    {
        string EncryptionKey = "MAKV2SPNIC99212";
        byte[] clearBytes = Encoding.Unicode.GetBytes(clearText);
        using (Aes encryptor = Aes.Create())
        {
            Rfc2898DeriveBytes pdb = new Rfc2898DeriveBytes(EncryptionKey, new byte[] { 0x49, 0x76, 0x61, 0x6e, 0x20, 0x4d, 0x65, 0x64, 0x76, 0x65, 0x64, 0x65, 0x76 });
            encryptor.Key = pdb.GetBytes(32);
            encryptor.IV = pdb.GetBytes(16);
            using (MemoryStream ms = new MemoryStream())
            {
                using (CryptoStream cs = new CryptoStream(ms, encryptor.CreateEncryptor(), CryptoStreamMode.Write))
                {
                    cs.Write(clearBytes, 0, clearBytes.Length);
                    cs.Close();
                }
                clearText = Convert.ToBase64String(ms.ToArray());
            }
        }
        return clearText;
    }

    [System.Web.Script.Services.ScriptMethod()]
    [System.Web.Services.WebMethod]
    public static string CalCulatePrepaidCardPoints(string amount, bool QPOST)
    {

        float lfltDeliveryCharge = 0;
        if (QPOST)
        {
            lfltDeliveryCharge = Convert.ToSingle(ConfigurationManager.AppSettings["DeliveryCharge"]);
        }
        string strMessage = string.Empty;
        try
        {
            if (Convert.ToInt32(amount) > 0)
            {
                HttpContext.Current.Session["PrepaidRedeemAmount"] = amount;
                HttpContext.Current.Session["PrepaidDeliveryCharge"] = lfltDeliveryCharge;
                ABCModel lobjQIBModel = new ABCModel();
                MemberDetails lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
                string lstrCurrency = HttpContext.Current.Session["Currency"].ToString();

                MemberRelation lobjMemberRelation = new MemberRelation();
                lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));
                try
                {
                    var Pointrate = lobjQIBModel.GetProgramRedemptionRate(lstrCurrency, RedemptionCodeKeys.AIR.ToString(), lobjMemberDetails.ProgramId);
                    var RedeemAmount = Convert.ToSingle(amount) + lfltDeliveryCharge;

                    var AbsherPoint = Convert.ToInt32(Convert.ToSingle(amount) / Pointrate);

                    var DeliveryChargePoint = Convert.ToInt32(lfltDeliveryCharge / Pointrate);

                    //var Totalpoints = RedeemAmount / Pointrate;

                    var Totalpoints = AbsherPoint + DeliveryChargePoint;

                    int seletedPoints = Convert.ToInt32(Totalpoints);
                    HttpContext.Current.Session["PrepaidRedeemPoints"] = seletedPoints;
                    strMessage = "Success|" + seletedPoints + "|" + DeliveryChargePoint + "|" + AbsherPoint;
                }
                catch (Exception ex)
                {
                    LoggingAdapter.WriteLog("CalCulatePrepaidCardPoints ex - " + ex.Message + Environment.NewLine + ex.StackTrace);
                }
            }
            else
            {
                strMessage = "Failed|" + amount;
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("CalCulatePrepaidCardPoints -" + ex.Message + Environment.NewLine + "Stack Trace-" + ex.StackTrace);
        }
        return strMessage;
    }

    [System.Web.Script.Services.ScriptMethod()]
    [System.Web.Services.WebMethod]
    public static string CheckAvailability()
    {
        string strMessage = string.Empty;
        try
        {
            ABCModel lobjQIBModel = new ABCModel();
            MemberDetails lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
            string lstrCurrency = HttpContext.Current.Session["Currency"].ToString();
            MemberRelation lobjMemberRelation = new MemberRelation();
            lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));

            try
            {
                var availablePoints = lobjQIBModel.CheckAvailbility(lobjMemberRelation.RelationReference, Convert.ToInt32(lobjMemberRelation.RelationType), lstrCurrency);

                strMessage = "Success|" + availablePoints + "|" + HttpContext.Current.Session["PrepaidRedeemPoints"] + "|" + HttpContext.Current.Session["PrepaidRedeemAmount"] + "|" + HttpContext.Current.Session["PrepaidDeliveryCharge"];
            }
            catch (Exception ex)
            {
                LoggingAdapter.WriteLog("PrepaidCard ex - " + ex.Message + Environment.NewLine + ex.StackTrace);
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("PrepaidCard -" + ex.Message + Environment.NewLine + "Stack Trace-" + ex.StackTrace);

        }
        return strMessage;
    }

    [System.Web.Script.Services.ScriptMethod()]
    [System.Web.Services.WebMethod]
    public static string PrepaidCardRedeempoints()
    {
        string lstrStatus = string.Empty;
        string lstrResponse = string.Empty;
        int pintAvailablePoints = 0;
        string lstrDeliveryOptions = string.Empty;

        MemberDetails lobjMemberDetails = new MemberDetails();
        ABCModel lobjmodel = new ABCModel();
        string lstrCurrency = HttpContext.Current.Session["Currency"].ToString();
        int lintPoints = Convert.ToInt32(HttpContext.Current.Session["PrepaidRedeemPoints"]);
        float lfltCardAmount = Convert.ToSingle(HttpContext.Current.Session["PrepaidRedeemAmount"]);
        float lfltDeliveryCharge = Convert.ToSingle(HttpContext.Current.Session["PrepaidDeliveryCharge"]);
        try
        {
            lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
            if (lobjMemberDetails != null)
            {
                ABCModel lobjQIBModel = new ABCModel();
                var Pointrate = lobjQIBModel.GetProgramRedemptionRate(lstrCurrency, RedemptionCodeKeys.AIR.ToString(), lobjMemberDetails.ProgramId);
                MemberRelation lobjMemberRelation = new MemberRelation();
                lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));
                TransactionDetails lobjTransactionDetails = new TransactionDetails();
                lobjTransactionDetails.TransactionType = TransactionType.Debit;
                lobjTransactionDetails.Amounts = (decimal)lfltCardAmount + (decimal)lfltDeliveryCharge;

                lobjTransactionDetails.TransactionCurrency = lstrCurrency;

                if (lfltDeliveryCharge > 0)
                {
                    lobjTransactionDetails.AdditionalDetail = "Q POST Delivery";
                    lstrDeliveryOptions = "Qatar Post";
                }
                else
                {
                    lobjTransactionDetails.AdditionalDetail = "Service Delivery Center";
                    lstrDeliveryOptions = "Service Delivery Center - C-Ring Road";
                }
                lobjTransactionDetails.TransactionDate = DateTime.Now;
                lobjTransactionDetails.ProcessingDate = DateTime.Now;
                lobjTransactionDetails.ExpiryDate = DateTime.Now;
                lobjTransactionDetails.RelationReference = lobjMemberRelation.RelationReference;
                lobjTransactionDetails.ExternalReference = GenerateUniqueNumber.Get12DigitNumberDateTime();
                lobjTransactionDetails.MerchantName = "Hadiyati Prepaid Card";
                lobjTransactionDetails.LoyaltyTxnType = LoyaltyTxnType.PrepaidCard;
                lobjTransactionDetails.IsActive = true;
                lobjTransactionDetails.RelationType = RelationType.LBMS;
                lobjTransactionDetails.ProgramId = lobjMemberDetails.ProgramId;
                lobjTransactionDetails.AdditionalDetails1 = Convert.ToString(lfltDeliveryCharge);
                lobjTransactionDetails.Narration = "Redemption " + lobjTransactionDetails.LoyaltyTxnType.ToString();

                TransactionDetailsBreakage lobjTransactionDetailsBreakage = new TransactionDetailsBreakage();
                lobjTransactionDetailsBreakage.Amount = lobjTransactionDetails.Amounts;
                lobjTransactionDetailsBreakage.Narration = lobjTransactionDetails.Narration;
                lobjTransactionDetailsBreakage.IsBillable = true;
                lobjTransactionDetails.TransactionDetailBreakage = new TransactionDetailsBreakage();
                lobjTransactionDetails.TransactionDetailBreakage = lobjTransactionDetailsBreakage;

                //----Change on 06-May-2021----// 
                
                //var points = lobjTransactionDetails.Amounts / Pointrate;
                //int seletedPoints = Convert.ToInt32(points);


                var AbsherPoint = Convert.ToInt32(Convert.ToSingle(lfltCardAmount) / Pointrate);

                var DeliveryChargePoint = Convert.ToInt32(lfltDeliveryCharge / Pointrate);
               
                var Totalpoints = AbsherPoint + DeliveryChargePoint;

                lobjTransactionDetails.Points = Totalpoints;

                //lobjTransactionDetails.Points = seletedPoints;

                //----Change on 06-May-2021----//

                pintAvailablePoints = lobjmodel.CheckAvailbility(lobjMemberRelation.RelationReference, Convert.ToInt32(lobjMemberRelation.RelationType), lstrCurrency);

                if (lobjTransactionDetails.Points == lintPoints)
                {
                    if (pintAvailablePoints >= lintPoints)
                    {
                        bool RedeemResponse = lobjQIBModel.InsertTransactionDetails(lobjTransactionDetails);
                        if (RedeemResponse)
                        {
                            SendEmailSMS(lobjMemberDetails, lobjTransactionDetails, lstrDeliveryOptions);
                            lstrStatus = "SUCCESS";
                        }
                        else
                        {
                            lstrStatus = "REDEEM_FAILED";
                        }
                    }
                    else
                    {
                        lstrStatus = "INSUFFICIENT_POINTS";
                    }
                }
                else
                {
                    lstrStatus = "PointsMismatch";
                }
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("PrpaidCard Exception: " + ex.Message + ex.InnerException + ex.StackTrace);
        }

        return lstrStatus;
    }

    public static void SendEmailSMS(MemberDetails pobjMemberDetails, TransactionDetails pobjTransactionDetails, string lstrDeliveryOptions)
    {
        float lfltCardAmount = Convert.ToSingle(HttpContext.Current.Session["PrepaidRedeemAmount"]);
        try
        {
            EmailDetails lobjEmailDetail = new EmailDetails();
            List<string> lstEmailparameter = new List<string>();
            List<string> lstAttachment = new List<string>();
            CEHelper lobjcehelper = new CEHelper();
            lstEmailparameter.Add(pobjMemberDetails.LastName);
            lstEmailparameter.Add(pobjMemberDetails.MemberRelationsList[0].RelationReference);
            lstEmailparameter.Add(pobjMemberDetails.Email);
            lstEmailparameter.Add(pobjMemberDetails.MobileNumber);
            lstEmailparameter.Add(Convert.ToString(pobjTransactionDetails.Points));
            lstEmailparameter.Add(pobjTransactionDetails.ExternalReference);
            lstEmailparameter.Add(Convert.ToString(lfltCardAmount + " QR"));
            lstEmailparameter.Add(lstrDeliveryOptions);
            lobjEmailDetail.TemplateCode = "PrepaidCardQIBTeam";
            lobjEmailDetail.ListParameter = lstEmailparameter;
            lobjEmailDetail.MemberId = Convert.ToString(pobjMemberDetails.MemberRelationsList[0].RelationReference);
            lobjEmailDetail.AttachmentList = lstAttachment;
            lobjEmailDetail.To = string.Empty;
            lobjEmailDetail.ProgramId = Convert.ToString(pobjMemberDetails.ProgramId);
            lobjcehelper.InsertEmailDetails(lobjEmailDetail);
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("Prepaid Card Email QIBTeam :" + ex.Message + " | " + ex.StackTrace);
        }

        try
        {
            if (pobjMemberDetails.Email != string.Empty)
            {
                EmailDetails lobjEmailDetail = new EmailDetails();
                List<string> lstEmailparameter = new List<string>();
                List<string> lstAttachment = new List<string>();
                CEHelper lobjcehelper = new CEHelper();
                lstEmailparameter.Add(Convert.ToString(pobjTransactionDetails.Amounts));
                lstEmailparameter.Add(Convert.ToString(pobjTransactionDetails.Points));
                lstEmailparameter.Add(pobjTransactionDetails.AdditionalDetail);
                lstEmailparameter.Add(pobjTransactionDetails.ExternalReference);
                lstEmailparameter.Add(pobjTransactionDetails.AdditionalDetails1);
                lstEmailparameter.Add(pobjMemberDetails.MemberRelationsList[0].RelationReference);
                lobjEmailDetail.TemplateCode = "PrepaidCard";
                lobjEmailDetail.ListParameter = lstEmailparameter;
                lobjEmailDetail.MemberId = Convert.ToString(pobjMemberDetails.MemberRelationsList[0].RelationReference);
                lobjEmailDetail.AttachmentList = lstAttachment;
                lobjEmailDetail.To = pobjMemberDetails.Email;
                lobjEmailDetail.ProgramId = Convert.ToString(pobjMemberDetails.ProgramId);
                lobjcehelper.InsertEmailDetails(lobjEmailDetail);
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("Prepaid Card Email :" + ex.Message + " | " + ex.StackTrace);
        }

        try
        {
            if (pobjMemberDetails.MobileNumber != string.Empty)
            {
                //Communication Engine Call For SMS. 
                CEHelper lobjcehelper = new CEHelper();
                SmsDetails lobjSmsDetail = new SmsDetails();
                List<string> lstSmsparameter = new List<string>();
                lstSmsparameter.Add(Convert.ToString(pobjTransactionDetails.Amounts));
                lstSmsparameter.Add(Convert.ToString(pobjTransactionDetails.Points));
                lstSmsparameter.Add(pobjTransactionDetails.AdditionalDetail);
                lstSmsparameter.Add(pobjTransactionDetails.ExternalReference);
                lstSmsparameter.Add(pobjTransactionDetails.AdditionalDetails1);
                lobjSmsDetail.ListParameter = lstSmsparameter;
                lobjSmsDetail.TemplateCode = "PrepaidCard";
                lobjSmsDetail.MemberId = Convert.ToString(pobjMemberDetails.MemberRelationsList[0].RelationReference);
                lobjSmsDetail.ReceiverMobile = Convert.ToString(pobjMemberDetails.MobileNumber);
                lobjSmsDetail.ProgramId = Convert.ToString(pobjMemberDetails.ProgramId);
                lobjcehelper.InsertSmsDetails(lobjSmsDetail);
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("Prepaid Card SMS :" + ex.Message + " | " + ex.StackTrace);
        }
    }

}

