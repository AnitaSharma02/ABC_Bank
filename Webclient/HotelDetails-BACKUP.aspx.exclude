<%@ Page Title="Hotel Details" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true"
    CodeFile="HotelDetails.aspx.cs" Inherits="HotelDetails" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">
    <script src="Jquery/HotelDetails.js" type="text/javascript"></script>
    <style>
        hr {
            margin: 20px 0 20px 0;
        }

        .contact-links ul li {
            width: 100%;
        }

        .divw20 {
            float: left;
            width: 25px;
        }

        .divw80 {
            float: none;
            width: auto;
            color: #000;
            font-weight: 400;
        }

        .websitelnk,
        .ico_weblink {
            color: #000;
            font-weight: 400;
        }

        .listing-cube .img span, .lightgreybg .banner span {
            font-size: 12px;
        }

        .rating {
            display: none;
        }

        .pointsPadd {
            padding: 0 10px !important;
        }

        .innerBox h3.sim-head {
            font-family: 'Roboto', sans-serif;
            font-size: 18px;
            font-weight: bold;
            color: #000;
            margin: 10px 0;
            padding: 0 10px;
        }

        hr {
            float: none;
        }

        @media (max-width: 800px) {
            .hotelBox {
                margin: 0;
            }
        }

        @media screen and (max-width: 600px) {
            .innerBox {
                padding: 0%;
            }

            .p-4 {
                padding: 0;
            }
        }

        #updProgress {
            display: none !important;
        }
    </style>
    <div class="breadcrumbBox mb-3 mb-lg-5">
        <div class="container">
            <div class="flightPage">
                <div class="breadcrumbFlight">
                    <ul class="d-flex">
                        <li>
                            <a href="\">
                                <img class="pr-3" src="../images/arrow-left.svg" />
                            </a>
                        </li>
                        <li><a href="\" class="custom-text">Home</a></li>
                        <li class="px-2">/</li>
                        <li><a href="HotelSearch.aspx">Hotel Search</a></li>
                        <li class="px-2">/</li>
                        <li class="brd-bold fontBold">Hotel Details</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="hotelBox">
        <div class="container">
            <div class="innerBox border2 mb-5 p-4">
                <div class="hotel-landing-hdr">
                    <div class="hotelinfo">
                        <h1>
                            <span id="HotelName"></span>
                        </h1>
                        <p>
                            <span id="HotelAddress"></span><span id="HotelCity"></span>
                        </p>
                        <div id="divrating">
                        </div>
                        <div class="contact-links">
                            <ul id="contact1">
                            </ul>
                            <ul id="contact2">
                            </ul>
                            <div class="clr">
                            </div>
                            <div class="about-add-amen" id="BasicAmenities">
                            </div>
                            <span id="minrate" class="w100P"></span>
                        </div>
                    </div>
                    <div class="hotelinfoImg">
                        <div class="Hotelbanner" id="BannerImage">
                            <div id="divpre" class="btnPre purple-btn" data-i18n="hotel-details-prev">
                                Prev
                            </div>
                            <div id="divNext" class="btnNext purple-btn" data-i18n="hotel-details-next">
                                Next
                            </div>
                        </div>
                    </div>
                    <div style="visibility: hidden;">&nbsp;</div>
                    <div class="selectroom w100P">
                        <h2 class="sel-room-head" data-i18n="hotel-select-room">Select Your Room</h2>
                        <div id="rptRoomDetails">
                        </div>
                        <div class="clr"></div>
                    </div>
                </div>
                <hr style="margin: 30px 0;" />
                <div class="hotel-landing-hdr">
                    <!--About Hotel Starts-->
                    <div class="about-hotel" id="OverView">
                    </div>
                    <div id="DivAmenities" class="hidecontent">
                        <div class="Closepopup_btn">
                            <img id="linkbuttonclose" src="Images/ico_close.png" onclick="return CloseDetails();" />
                        </div>
                    </div>
                    <div id="Fade" class="black_overlay">
                    </div>
                    <!--About Hotel Ends-->
                    <div class="col2" style="display: none;">
                        <div class="map" id="divGoogleMaps">
                            <img id="imgMap" alt="Map" style="width: 100%" />
                        </div>
                    </div>
                </div>
                <div class="hotel-landing-hdr">
                    <div class="sim-list">
                        <div class="wrap1 HtlBgDetail">
                            <h2 class="card-heading py-5" data-i18n="hotel-similar-listing">Similar Listing</h2>
                            <div id="NextHotelList" class="row">
                            </div>
                        </div>
                    </div>
                    <div class="clr"></div>
                </div>
            </div>
        </div>
    </div>
</asp:Content>
