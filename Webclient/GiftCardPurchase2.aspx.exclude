<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true" CodeFile="GiftCardPurchase2.aspx.cs" Inherits="GiftCardPurchase2" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">

    <link href="Css/qib-voucher-en.css" rel="stylesheet" type="text/css" />
    <link href="Css/qib-dropDown.css" rel="stylesheet" type="text/css" />
    <script src="Jquery/Voucher.js" type="text/javascript"></script>

     <style type="text/css">
        .errormsg {color: red; font-size: 14px;}
        div#sitemap { display: none;}
 	.giftCards h3{ text-align: center !important;}

        @media screen and (max-width:650px){
        .vouWrap { width: unset !important;}
        .voucherDetail {padding-right: 0 !important;}
        .divRight { float: left; margin-top: 15px;}
        .blue_button, .blue_button:hover { padding: 15px 45px !important;}
        .vouWrap .card-body {padding: 0 !important;}
        .respad0 {padding:0px;margin: 0px !important;}
        h3.card-title span {padding: 0px 0 5px 0; margin-bottom: 0; text-align: left;}
        #CP_spanUnits .btn {padding: 8px;min-width: 41px;}

        }
    </style>

  <script type="text/javascript">
      $(document).ready(function () {

          // Language Toggle
          var query = window.location.search.substring(1);
          var qs = parse_query_string(query);
          $(document).on("langSelectorEvent", {}, function (event, lang) {
              getGiftCard(qs.CardId, lang);
          });
          getGiftCard(qs.CardId, $.i18n().Locale);

          //
          $("#cssload-wrapper").hide();
          $("#dnarr").on('click', function (event) {
              if (this.hash !== "") {
                  event.preventDefault();
                  var hash = this.hash;
                  $('html, body').animate({
                      scrollTop: $(hash).offset().top
                  }, 800, function () {
                      window.location.hash = hash;
                  });
              }
          });
      });

      function getGiftCard(cardId, Locale) {
          $.ajax({
              type: "POST",
              url: "GiftCardPurchase2.aspx/GetCardDetails",
              data: "{'cardId':'" + cardId + "', 'locale':'" + Locale + "'}",
              contentType: 'application/json; charset=utf-8',
              dataType: 'json',
              error: function (XMLHttpRequest, textStatus, errorThrown) {
                  //alert("Request: " + XMLHttpRequest.toString() + "\n\nStatus: " + textStatus + "\n\nError: " + errorThrown);
                  location.href = "GiftCards2.aspx";
              },
              success: function (result) {
                  var p = result.d;
                  if (p == null) {
                      location.href = "GiftCards2.aspx";
                  } else {
                      for (var key of Object.keys(p)) {
                          $('#CP_' + key).html(p[key]);
                      }
                  }
              }
          });
      }

      function getPoints(id) {

          $("#CP_spanUnits").find("button").css("border", "1px solid #999999");

          $(".btnUnits" + id).css("border", "4px solid #E17F25");

          $.ajax({
              type: "POST",
              url: "GiftCardPurchase2.aspx/GetTotalPoints",
              data: "{'unitId':'" + id.toString() + "'}",
              contentType: 'application/json; charset=utf-8',
              dataType: 'json',
              error: function (XMLHttpRequest, textStatus, errorThrown) {
                  //alert("Request: " + XMLHttpRequest.toString() + "\n\nStatus: " + textStatus + "\n\nError: " + errorThrown);
                  alert("Oops! Something went wrong, please try again later.");
              },
              success: function (result) {
                  //alert("We returned: " + result.d);
                  if (result.d != "") {
                      $('#CP_spanTotalPoints').html(numberWithCommas(result.d));
                      $("#CP_hfUnitId").val(id);

                      $('#spanRedeemPoints').html("");
                      $('#spanRedeemPoints').html(numberWithCommas(result.d));

                  }
              }
          });

      };

      function numberWithCommas(x) {
          return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      }

      function buyGiftCard() {

          // document.getElementById("CP_divBtnConfirm").style.display = "none";
          $("#cssload-wrapper").show();

          var unitId = $("#CP_hfUnitId").val();

          var msg = "";
          var checkBoxTnC = document.getElementById("chbTermsnCondition");
          var checkBoxRedeemPoints = document.getElementById("chbRedeemPoints");

          if (checkBoxTnC.checked == false || checkBoxRedeemPoints.checked == false) {
              msg += $.i18n('text-please-accept-terms') + '<br>';
          }
          if ($("#CP_hfUnitId").val().length == 0) {
              msg += $.i18n('text-select-unit') + '<br>';
          }

          if (msg.length > 0) {

              $("#checkboxerror").show();
              $("#checkboxerror").html(msg);
          }
          else {
              $("#checkboxerror").hide();
              $("#checkboxerror").html('');

              $("#CP_divBtnConfirm").hide();

              $.ajax({
                  type: "POST",
                  url: "GiftCardPurchase2.aspx/BuyGiftCard",
                  data: "{'unitId':'" + unitId.toString() + "'}",
                  contentType: 'application/json; charset=utf-8',
                  dataType: 'json',
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      //alert("Request: " + XMLHttpRequest.toString() + "\n\nStatus: " + textStatus + "\n\nError: " + errorThrown);
                      alert("Oops! Something went wrong, please try again later.");
                      $("#CP_cssload-wrapper").hide();
                  },
                  success: function (result) {
                      $("#cssload-wrapper").hide();
                      if (result.d == "SUCCESS") {
                          $("#CP_divConfirmationMsg").removeClass("display_hide");
                          $("#CP_DivGlobalRewardsConfirm").addClass("display_hide");
                      }
                      else if (result.d == "INSUFFICIENT_POINTS") {
                          alert("Insufficient Points.")
                      }
                      else {
                          alert("Purchase failed!!! Please try again later.")
                      }

                  }
              });
              return false;
          }
      }

      function redirect() {
          location.href = "GiftCards2.aspx";
      }

    </script>

    <script type="text/javascript">
    </script>

   <div class="container giftCards">
    <article id="article" >
        <div class="wrap">
            <%--<h1>Every Reason To Feel Wonderful.</h1>--%>
            <div class="servindx">
                <div id="voucher" class="tabbertabVoucher voucher_cnf">
                    <div class="width100" id="DivGlobalRewardsConfirm" runat="server">
                        <div class="vouWrap vouConfirm row">
                            <div class="col-md-4">
                                <div id="divImage" runat="server"></div>
                            </div>
                            <div class="voucherDetail col-md-7 ml-auto" >
                                <h3 class="card-title"><span id="spanName" runat="server"></span></h3>
                                <p class="card-text">
                                    <span id="spanDescription" runat="server"></span>
                                </p>
                                <h4 style="margin-top: 15px;" data-i18n="text-select-voucher-value">Select Voucher value: <b><span id="spanCurrencyname" runat="server"></span></b>  </h4>
                                <span id="spanUnits" runat="server"></span>
                                <br/>
                                <div>
                                    <p class="pResult"><span data-i18n="text-points">Points:</span><span id="spanTotalPoints" runat="server">0</span></p>
                                </div>
                               
                                <div class="chkTerms">
								<input type="checkbox" id="chbTermsnCondition" value="I agree to redeem  0 ABSHER POINTS." />                               
                                <span data-i18n="text-have-agreed-redeem">I agree to redeem</span> <span id="spanRedeemPoints">0 </span> <strong style="font-weight: bold;" data-i18n="text-absher-points">ABSHER POINTS</strong>. 
                                
                                                                
                                <br />
                                <input type="checkbox" id="chbRedeemPoints" value="I have read and agreed to AL MEERA Terms & Conditions.." />
                                <span data-i18n="text-have-read-agreed">I have read and agreed to</span> <span style="font-weight: bold;" id="spanGCname" runat="server"></span> <span data-i18n="text-terms-conditions">Terms & Conditions.</span>                                                                
                                 <br />

                                 <span id="checkboxerror" class="errormsg" style="display: none; " data-i18n="voucher-accespt-terms">Please accept the terms to proceed with the redemption.
                                 </span>
                                    </div>
                            </div>
                        </div>
                        <div class="btmInfo1 respad0 giftcardpurchase">
                            <div class="divRight">
                                <a href="#" class="blue_buttongray" onclick=" redirect(); return false;" alt="Back" data-i18n="btn-back">Back</a>
                                <span id="divBtnConfirm" runat="server">
                                    <a href="#" class="blue_button" onclick="buyGiftCard();" alt="Continue" data-i18n="btn-continue">
                                        Continue
                                        
                                    </a>
                                </span>
                            </div>
                            <br class="clr">    
                        </div>
                        <div class="vouWrap vouConfirm respad0" style="margin-top: 20px;">                            
                            <br />
                            <div id="divTC" runat="server" class="card-body">
                            </div>
                        </div>
                    </div>
                    <!--End of Voucher Confirm-->
                </div>
                <div class="width100 msgbxBG mTop20 display_hide " style="text-align:center;direction:ltr" id="divConfirmationMsg" runat="server">
                   <br><br><br><br><h3 data-i18n="giftcardpurchase-cong">Congratulations!</h3>
                 
                    <h4 data-i18n="giftcardpurchase-yourtransaction">Your transaction is successful and the voucher has been mailed to your registered email ID.<br /></h4>
               
                </div>
            </div>
            <!--end of new html-->
        </div>

        <div class="clr">
        </div>
        <asp:HiddenField ID="hfUnitId" runat="server" />
    </article>
    </div>

</asp:Content>

