public partial class PaymentOptions : System.Web.UI.Page
{
    protected void Page_Load(object sender, EventArgs e)
    {
        if (!Page.IsPostBack)
        {
            if (Session["MemberDetails"] == null)
            {
                string CallbackUrl = HttpUtility.UrlEncode(Encrypt("PaymentOptions.aspx"));
                HttpContext.Current.Session["CallbackUrl"] = CallbackUrl;
                Response.Redirect("Login.aspx?CallbackUrl=" + CallbackUrl, false);
            }
        }

    }

    [WebMethod]
    public static string BindDetails()
    {
        string lstrresponse = string.Empty;
        string lstrProductAmount = string.Empty;
        int RequiredPoints = 0;
        int lintProductAmount = 0;
        double dblProductAmount = 0.0f;
        string lstrBookingFlag = string.Empty;
        ABCModel lobjNICModel = new ABCModel();

        try
        {
            if (HttpContext.Current.Session["BookingFlag"] != null)
            {
                lstrBookingFlag = HttpContext.Current.Session["BookingFlag"].ToString();
            }

            ProgramDefinition lobjProgramDefinition = lobjNICModel.GetProgramMaster();
            List<ProgramCurrencyDefinition> lobjProgramCurrencyDefinition = lobjNICModel.GetProgramCurrencyDefinition(lobjProgramDefinition.ProgramId);
            var PointRate = lobjProgramCurrencyDefinition[0].RedemptionRate;

            if (lstrBookingFlag.ToLower().Equals("digitalproduct") || lstrBookingFlag.ToLower().Equals("physicalproduct"))
            {
                if (HttpContext.Current.Session["ShoppingCart"] as ShoppingCart != null)
                {
                    try
                    {
                        ShoppingCart Cart = HttpContext.Current.Session["ShoppingCart"] as ShoppingCart;

                        //lintProductAmount = Convert.ToInt32(Math.Ceiling(Cart.Price.Total.Amount));

                        lintProductAmount = (Convert.ToInt32(Cart.Prices.FirstOrDefault(x => x.Currency.Code == ConfigurationManager.AppSettings["ShopCurrency"]).SubTotalWithTax.TruncatedAmount));

                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(lintProductAmount);

                        RequiredPoints = Convert.ToInt32(Math.Ceiling(Cart.Price.Total.Amount));  //lobjNICModel.CalculatePoint(lintProductAmount, PointRate);
                    }
                    catch (Exception ex)
                    {
                        LoggingAdapter.WriteLog("PaymentOptions Shop & Digital Booking Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                    }
                }
            }
            if (lstrBookingFlag.ToLower().Equals("hotel"))
            {
                try
                {
                    if (HttpContext.Current.Session["HotelTotalRedeemAmount"] != null)
                    {
                        RequiredPoints = Convert.ToInt32(HttpContext.Current.Session["HotelTotalRedeemAmount"]);
                        dblProductAmount = lobjNICModel.CalculateAmount(RequiredPoints, PointRate);
                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                    }
                }
                catch (Exception ex)
                {
                    LoggingAdapter.WriteLog("PaymentOptions Hotel Booking Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                }
            }
            if (lstrBookingFlag.ToLower().Equals("flight"))
            {
                try
                {
                    if (HttpContext.Current.Session["FlightTotalRedeemAmount"] != null)
                    {
                        RequiredPoints = Convert.ToInt32(HttpContext.Current.Session["FlightTotalRedeemAmount"]);
                        dblProductAmount = lobjNICModel.CalculateAmount(RequiredPoints, PointRate);
                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                    }
                }
                catch (Exception ex)
                {
                    LoggingAdapter.WriteLog("PaymentOptions Flight Booking Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                }
            }
            if (lstrBookingFlag.ToLower().Equals("domesticflight"))
            {
                try
                {
                    if (HttpContext.Current.Session["FlightTotalRedeemAmount"] != null)
                    {
                        RequiredPoints = Convert.ToInt32(HttpContext.Current.Session["FlightTotalRedeemAmount"]);
                        dblProductAmount = lobjNICModel.CalculateAmount(RequiredPoints, PointRate);
                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                    }
                }
                catch (Exception ex)
                {
                    LoggingAdapter.WriteLog("PaymentOptions Flight Booking Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                }
            }
            if (lstrBookingFlag.ToLower().Equals("car"))
            {
                try
                {
                    if (HttpContext.Current.Session["CarTotalRedeemAmount"] != null)
                    {
                        //RequiredPoints = Convert.ToInt32(HttpContext.Current.Session["FlightTotalRedeemAmount"]);
                        dblProductAmount = Convert.ToDouble(HttpContext.Current.Session["CarTotalRedeemAmount"]);

                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                    }
                }
                catch (Exception ex)
                {
                    LoggingAdapter.WriteLog("PaymentOptions Car Booking Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                }
            }
            if (lstrBookingFlag.ToLower().Equals("experience"))
            {
                if (HttpContext.Current.Session["ExperienceBookingDetails"] != null)
                {
                    try
                    {
                        OrderStatusResponse lobjOrderStatusResponse = (OrderStatusResponse)HttpContext.Current.Session["ExperienceBookingDetails"];
                        OrderStatusRawData lobjOrderStatus = JsonConvert.DeserializeObject<OrderStatusRawData>(lobjOrderStatusResponse.data.getOrderStatus);

                        var lintTotalPrice = lobjOrderStatus.data.rawData.data.booking.availabilityList.nodes.Select(x => x.totalPrice.gross).FirstOrDefault();

                        lintProductAmount = Convert.ToInt32(Math.Ceiling(lintTotalPrice));
                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(lintProductAmount);

                        RequiredPoints = lobjNICModel.CalculatePoints(lintProductAmount, PointRate);
                    }
                    catch (Exception ex)
                    {
                        LoggingAdapter.WriteLog("PaymentOptions ExperienceBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                    }
                }
            }
            if (lstrBookingFlag.ToLower().Equals("insuranceserviceproviders"))
            {
                if (HttpContext.Current.Session["InsuranceUserDetails"] != null)
                {
                    try
                    {
                        InsuranceUserDetailsResponse lobjUserdetails = HttpContext.Current.Session["InsuranceUserDetails"] as InsuranceUserDetailsResponse;
                        string lstrCurrency = lobjNICModel.GetDefaultCurrency();
                        int lintPoints = lobjNICModel.ConvertToPoints(float.Parse(lobjUserdetails.results.Amount.ToString())
                         , lstrCurrency, lobjProgramDefinition.ProgramId, "INSURANCE");

                        lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(lobjUserdetails.results.Amount));
                        RequiredPoints = lintPoints;
                    }
                    catch (Exception ex)
                    {
                        LoggingAdapter.WriteLog("PaymentOptions InsuranceBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                    }
                }
            }
            if (lstrBookingFlag.ToLower().Equals("internetserviceproviders"))
            {
                if (HttpContext.Current.Session["ISPUserDetails"] != null)
                {
                    try
                    {
                        ISPUserDetailsResponse lobjUserdetails = HttpContext.Current.Session["ISPUserDetails"] as ISPUserDetailsResponse;
                        string lstrCurrency = lobjNICModel.GetDefaultCurrency();
                        MemberDetails lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
                        string serviceCode = Convert.ToString(HttpContext.Current.Session["ISPServiceCode"]);
                        decimal FinalAmountPayable = Convert.ToDecimal(HttpContext.Current.Session["FinalAmountPayable"]);
                        Packages PackageData = HttpContext.Current.Session["ISPSelectedPackageData"] as Packages;
                        Details PackageDetailsData = HttpContext.Current.Session["ISPSelectedPackageDetailsData"] as Details;
                        string RequestId = HttpContext.Current.Session["ISPUserName"].ToString();
                        if (lobjMemberDetails != null)
                        {
                            if (lobjUserdetails != null)
                            {
                                if (lobjUserdetails.results.Key == "BroadLink" && lobjUserdetails.results.Packages.Count > 0)
                                {
                                    //call GetDiscount and then ISPPaymentRequest API
                                    GetDiscountRequest lobjGetDiscountRequest = new GetDiscountRequest();
                                    GetDiscountResponse lobjGetDiscountResponse = new GetDiscountResponse();
                                    lobjGetDiscountRequest.ServiceCode = serviceCode;
                                    lobjGetDiscountRequest.SessionId = lobjUserdetails.results.SessionId;
                                    lobjGetDiscountRequest.Package = PackageData;
                                    lobjGetDiscountResponse = lobjNICModel.GetDiscount(lobjGetDiscountRequest);
                                    if (lobjGetDiscountResponse != null)
                                    {
                                        if (lobjGetDiscountResponse.results.Status)
                                        {

                                            int lintPoints = lobjNICModel.ConvertToPoints(float.Parse(lobjGetDiscountResponse.results.Amount.ToString())
                                                , lstrCurrency, lobjProgramDefinition.ProgramId, "ISP");
                                            dblProductAmount = float.Parse(lobjGetDiscountResponse.results.Amount.ToString());
                                            lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                                            RequiredPoints = lintPoints;

                                        }
                                        else
                                        {
                                            LoggingAdapter.WriteLog("GetDiscountforISPBroadLink_Packages Failed");
                                        }
                                    }
                                    else
                                    {
                                        LoggingAdapter.WriteLog("GetDiscountforISPBroadLink_Packages Failed");
                                    }
                                }
                                else
                                {
                                    int lintPoints = Convert.ToInt32(HttpContext.Current.Session["FinalAmountPayable"]);
                                    dblProductAmount = lobjNICModel.CalculateAmount(lintPoints, PointRate);
                                    lstrProductAmount = "NPR " + lobjNICModel.IntToThousandSeperated(Convert.ToInt32(dblProductAmount));
                                    RequiredPoints = lintPoints;
                                }
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        LoggingAdapter.WriteLog("PaymentOptions ISPBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("PaymentOptions BindDetails Ex-" + ex.InnerException + ex.StackTrace + ex.Message);
        }

        lstrresponse = lstrProductAmount + "|" + RequiredPoints;

        return lstrresponse;
    }

    [WebMethod]
    public static string GetLoyaltyPoints()
    {
        ABCModel lobjPaymentModel = new ABCModel();

        string lstrPoints = "0";
        string lstrAccessToken = string.Empty;
        try
        {
            if (HttpContext.Current.Session["MemberDetails"] != null)
            {
                string lstrBookingFlag = string.Empty;
                ProgramDefinition lobjProgramDefinition = lobjPaymentModel.GetProgramMaster();
                MemberDetails lobjMemberDetails = null;
                lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;

                lstrPoints = Convert.ToString(lobjPaymentModel.CheckAvailbility(lobjMemberDetails.MemberRelationsList.Find(l => l.RelationType.Equals(RelationType.LBMS)).RelationReference, Convert.ToInt32(RelationType.LBMS), Convert.ToString(lobjPaymentModel.GetDefaultCurrency()), lobjProgramDefinition.ProgramId));

                if (lstrPoints != "0")
                {
                    HttpContext.Current.Session["AvailablePoint"] = lstrPoints;

                    if (HttpContext.Current.Session["BookingFlag"] != null)
                    {
                        lstrBookingFlag = HttpContext.Current.Session["BookingFlag"].ToString();
                    }

                    if (lstrBookingFlag.ToLower().Equals("digitalproduct") || lstrBookingFlag.ToLower().Equals("physicalproduct"))
                    {
                        if (HttpContext.Current.Session["ShoppingCart"] as ShoppingCart != null)
                        {
                            ShoppingCart Cart = HttpContext.Current.Session["ShoppingCart"] as ShoppingCart;
                            //lobjQIBMPPaymentDetails.TotalProductAmount = Math.Ceiling(Cart.Price.Total.Amount).ToString();
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("hotel"))
                    {
                        if (HttpContext.Current.Session["HotelTotalRedeemAmount"] != null)
                        {
                            // lobjQIBMPPaymentDetails.TotalProductAmount = Convert.ToString(HttpContext.Current.Session["HotelTotalRedeemAmount"]);
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("flight"))
                    {
                        if (HttpContext.Current.Session["FlightTotalRedeemAmount"] != null)
                        {
                            // lobjQIBMPPaymentDetails.TotalProductAmount = Convert.ToString(HttpContext.Current.Session["FlightTotalRedeemAmount"]);
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("experience"))
                    {
                        if (HttpContext.Current.Session["ExperienceBookingDetails"] != null)
                        {
                            OrderStatusResponse lobjOrderStatusResponse = (OrderStatusResponse)HttpContext.Current.Session["ExperienceBookingDetails"];
                            OrderStatusRawData lobjOrderStatus = JsonConvert.DeserializeObject<OrderStatusRawData>(lobjOrderStatusResponse.data.getOrderStatus);

                            var lintTotalPrice = lobjOrderStatus.data.rawData.data.booking.availabilityList.nodes.Select(x => x.totalPrice.gross).FirstOrDefault();
                            //lobjQIBMPPaymentDetails.TotalProductAmount = Math.Ceiling(lintTotalPrice).ToString();
                        }
                    }

                }
                // HttpContext.Current.Session["QIBMPPaymentDetails"] = lobjQIBMPPaymentDetails;
            }
            else
            {
                LoggingAdapter.WriteLog("PaymentOptions GetLoyaltyPoints MemberDetails null");
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("PaymentOptions GetLoyaltyPoints Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
        }
        return lstrPoints;
    }

    [WebMethod]
    public static string CreatePayment(int lintSelectedRedeemPoints, int lintActualProductPoints)
    {
        ABCModel lobjmodel = new ABCModel();
        StripePaymentDetails lobjStripePaymentDetails = new StripePaymentDetails();
        lobjStripePaymentDetails.ReqRedeemPoint = "0";
        string lstrResponse = string.Empty;
        int AvailablePoint = 0;
        try
        {
            if (HttpContext.Current.Session["MemberDetails"] != null)
            {
                MemberDetails lobjMemberDetails = null;
                lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
                string lstrProgramName = ProgramHelper.ProgramName();
                string lstrCurrency = lobjmodel.GetDefaultCurrency();
                ProgramDefinition lobjProgramDefinition = lobjmodel.GetProgramDetails(lstrProgramName);
                List<ProgramCurrencyDefinition> lobjlistProgramCurrencyDefinition = lobjmodel.GetProductProgramCurrencyDefinition(lobjMemberDetails);
                AvailablePoint = lobjmodel.CheckAvailbility(lobjMemberDetails.MemberRelationsList[0].RelationReference, Convert.ToInt32(RelationType.LBMS), lobjlistProgramCurrencyDefinition[0].Currency, lobjProgramDefinition.ProgramId);

                if (lobjMemberDetails != null)
                {
                    string lstrBookingFlag = string.Empty;
                    if (HttpContext.Current.Session["BookingFlag"] != null)
                    {
                        lstrBookingFlag = HttpContext.Current.Session["BookingFlag"].ToString();
                    }

                    if (lstrBookingFlag.ToLower().Equals("digitalproduct") || lstrBookingFlag.ToLower().Equals("physicalproduct"))
                    {
                        if (HttpContext.Current.Session["ShoppingCart"] as ShoppingCart != null)
                        {
                            ShoppingCart Cart = HttpContext.Current.Session["ShoppingCart"] as ShoppingCart;
                            lobjStripePaymentDetails.TotalProductAmount = Math.Ceiling(Cart.Price.Total.Amount).ToString();
                            lobjStripePaymentDetails.ProductName = Cart.Items[0].Name;
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("hotel"))
                    {
                        if (HttpContext.Current.Session["HotelTotalRedeemAmount"] != null)
                        {
                            lobjStripePaymentDetails.TotalProductAmount = Convert.ToString(HttpContext.Current.Session["HotelTotalRedeemAmount"]);
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("flight") || lstrBookingFlag.ToLower().Equals("domesticflight"))
                    {
                        if (HttpContext.Current.Session["FlightTotalRedeemAmount"] != null)
                        {
                            lobjStripePaymentDetails.TotalProductAmount = Convert.ToString(HttpContext.Current.Session["FlightTotalRedeemAmount"]);
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("car"))
                    {
                        if (HttpContext.Current.Session["CarTotalRedeemAmount"] != null)
                        {
                            lobjStripePaymentDetails.TotalProductAmount = Convert.ToString(HttpContext.Current.Session["CarTotalRedeemAmount"]);
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("experience"))
                    {
                        if (HttpContext.Current.Session["ExperienceBookingDetails"] != null)
                        {
                            try
                            {
                                string pstrGrossFormattedText = string.Empty;
                                OrderStatusResponse lobjOrderStatusResponse = (OrderStatusResponse)HttpContext.Current.Session["ExperienceBookingDetails"];
                                OrderStatusRawData lobjOrderStatus = JsonConvert.DeserializeObject<OrderStatusRawData>(lobjOrderStatusResponse.data.getOrderStatus);

                                var pfltPointrate = lobjmodel.GetProgramRedemptionRate(lstrCurrency, "EXPERIENCE", lobjProgramDefinition.ProgramId);

                                var lintTotalPrice = lobjmodel.CalculatePoints(Convert.ToDecimal(lobjOrderStatus.data.rawData.data.booking.availabilityList.nodes.Select(x => x.totalPrice.gross).FirstOrDefault()), pfltPointrate);

                                //var lintTotalPrice = lobjOrderStatus.data.rawData.data.booking.availabilityList.nodes.Select(x => x.totalPrice.gross).FirstOrDefault();

                                lobjStripePaymentDetails.ReqRedeemPoint = lintSelectedRedeemPoints.ToString();
                                lobjStripePaymentDetails.TotalProductAmount = (lintTotalPrice).ToString();
                            }
                            catch (Exception ex)
                            {
                                LoggingAdapter.WriteLog("PaymentOptions ExperienceBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                            }
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("insuranceserviceproviders"))
                    {
                        if (HttpContext.Current.Session["InsuranceUserDetails"] != null)
                        {
                            try
                            {
                                InsuranceUserDetailsResponse lobjUserdetails = HttpContext.Current.Session["InsuranceUserDetails"] as InsuranceUserDetailsResponse;
                                int lintPoints = lobjmodel.ConvertToPoints(float.Parse(lobjUserdetails.results.Amount.ToString())
                                 , lstrCurrency, lobjProgramDefinition.ProgramId, "INSURANCE");

                                lobjStripePaymentDetails.ReqRedeemPoint = lintSelectedRedeemPoints.ToString();
                                lobjStripePaymentDetails.TotalProductAmount = (lintPoints).ToString();
                            }
                            catch (Exception ex)
                            {
                                LoggingAdapter.WriteLog("PaymentOptions InsuranceBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                            }
                        }
                    }
                    if (lstrBookingFlag.ToLower().Equals("internetserviceproviders"))
                    {
                        if (HttpContext.Current.Session["ISPUserDetails"] != null)
                        {
                            try
                            {
                                ISPUserDetailsResponse lobjUserdetails = HttpContext.Current.Session["ISPUserDetails"] as ISPUserDetailsResponse;
                                int lintPoints = Convert.ToInt32(HttpContext.Current.Session["FinalAmountPayable"]);
                                lobjStripePaymentDetails.ReqRedeemPoint = lintSelectedRedeemPoints.ToString();
                                lobjStripePaymentDetails.TotalProductAmount = (lintPoints).ToString();
                            }
                            catch (Exception ex)
                            {
                                LoggingAdapter.WriteLog("PaymentOptions ISPBookingDetails Pageload Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
                            }
                        }
                    }
                    lobjStripePaymentDetails.ReqRedeemPoint = lintSelectedRedeemPoints.ToString();

                    if (AvailablePoint >= lintSelectedRedeemPoints)
                    {
                        // check customer want to redeem  point else redirect to cards payment(Cash Payment)
                        if (lintSelectedRedeemPoints > 0)
                        {
                            // check ActualPoint & Selcted  point equals then make payment ofr loyalty(Only Points)
                            if (lintSelectedRedeemPoints == lintActualProductPoints)
                            {
                                lobjStripePaymentDetails.PaymentType = PaymentType.Points;
                                HttpContext.Current.Session["StripePaymentDetails"] = lobjStripePaymentDetails;
                                bool Status = false;
                                OTPDetails lobjOTPDetails = HttpContext.Current.Session["OtpDetails"] as OTPDetails;
                                if (lstrBookingFlag.ToLower().Equals("digitalproduct"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        //Status = lobjmodel.GenerateReviewnConfirmOTP(lobjOTPDetails, lobjMemberDetails);
                                        Product lobjProductDetails = new Product();
                                        lobjProductDetails = HttpContext.Current.Session["Product"] as Product;
                                        if (lobjProductDetails != null)
                                        {
                                            Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, lobjProductDetails.Properties.ToList().Find(x => x.Name.Equals("Type")).Value);
                                            if (Status)
                                            {
                                                lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "ShopDigital", lobjOTPDetails.UniquerefID, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                                lstrResponse = "/ValidateOTP.aspx?flag=ShopDigital&redemptiontype=" + lobjProductDetails.Properties.ToList().Find(x => x.Name.Equals("Type")).Value;

                                            }
                                            else
                                            {
                                                lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "ShopDigital", lobjOTPDetails.UniquerefID, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                                lstrResponse = "/OrderStatus.aspx?Status=false";
                                            }
                                        }
                                        else
                                        {
                                            lstrResponse = "/OrderStatus.aspx?Status=false";
                                        }

                                    }
                                    else
                                    {
                                        // lstrResponse = "/PointGateway.aspx?flag=ShopDigital";
                                        lstrResponse = "/OrderStatus.aspx?Status=false";
                                    }

                                }
                                else if (lstrBookingFlag.ToLower().Equals("physicalproduct"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, "Shop");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "SHOP", lobjOTPDetails.UniquerefID, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "/ValidateOTP.aspx?flag=Shop";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "SHOP", lobjOTPDetails.UniquerefID, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "/OrderStatus.aspx?Status=false";
                                        }
                                    }
                                    else
                                    {
                                        //lstrResponse = "/PointGateway.aspx?flag=Shop";
                                        lstrResponse = "/OrderStatus.aspx?Status=false";
                                    }
                                }
                                else if (lstrBookingFlag.ToLower().Equals("hotel"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        List<RedemptionDetails> lobjListOfRedemptionDetails = HttpContext.Current.Session["RedemptionDetails"] as List<RedemptionDetails>;
                                        RedemptionDetails lobjRedemptionDetails = lobjListOfRedemptionDetails[0];
                                        Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, "Hotel");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "HOTEL", lobjRedemptionDetails.RelationReference, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "ValidateOTP.aspx?flag=Hotel";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "HOTEL", lobjRedemptionDetails.RelationReference, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "BookingFailure.aspx";
                                        }
                                    }
                                    else
                                    {
                                        //lstrResponse = "/PointGateway.aspx?flag=Hotel";
                                        lstrResponse = "BookingFailure.aspx";
                                    }
                                }
                                else if (lstrBookingFlag.ToLower().Equals("experience"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        Status = lobjmodel.GenerateReviewnConfirmOTP(lobjOTPDetails, lobjMemberDetails, "Experience");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "EXPERIENCE", lobjMemberDetails.MemberRelationsList[0].RelationReference, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = string.Format("ValidateOTP.aspx?flag=Package", false);
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "EXPERIENCE", lobjMemberDetails.MemberRelationsList[0].RelationReference, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = string.Format("BookingFailure.aspx", false);
                                        }
                                    }
                                    else
                                    {
                                        //lstrResponse = "/PointGateway.aspx?flag=Package";
                                        lstrResponse = string.Format("BookingFailure.aspx", false);
                                    }
                                }
                                else if (lstrBookingFlag.ToLower().Equals("insuranceserviceproviders"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, "Insurance");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "Insurance", lobjOTPDetails.UniquerefID, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "/ValidateOTP.aspx?flag=Insurance";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "Insurance", lobjOTPDetails.UniquerefID, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "/OrderStatus.aspx?Status=false";
                                        }
                                    }
                                    else
                                    {
                                        // lstrResponse = "/PointGateway.aspx?flag=Insurance";
                                        lstrResponse = "/OrderStatus.aspx?Status=false";
                                    }
                                   
                                }
                                else if (lstrBookingFlag.ToLower().Equals("internetserviceproviders"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, "Internet Service Provider");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "ISP", lobjOTPDetails.UniquerefID, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "/ValidateOTP.aspx?flag=ISP";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "ISP", lobjOTPDetails.UniquerefID, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "/OrderStatus.aspx?Status=false";
                                        }
                                    }
                                    else
                                    {
                                        // lstrResponse = "/PointGateway.aspx?flag=ISP";
                                        lstrResponse = "/OrderStatus.aspx?Status=false";
                                    }                                      
                                }
                                else if (lstrBookingFlag.ToLower().Equals("domesticflight"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        List<RedemptionDetails> lobjListOfRedemptionDetails = HttpContext.Current.Session["RedemptionDetails"] as List<RedemptionDetails>;
                                        RedemptionDetails lobjRedemptionDetails = lobjListOfRedemptionDetails[0];
                                        Status = lobjmodel.GenerateReviewnConfirmOTP(lobjOTPDetails, lobjMemberDetails, "Domestic Flight");
                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format("KHALTI AIR ReviewConfirm OTP Request For Member {0} Status- {1}", lobjRedemptionDetails.RelationReference, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "ValidateOTP.aspx?flag=KhaltiAir";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format("KHALTI AIR ReviewConfirm OTP Request For Member {0} Status- {1}", lobjRedemptionDetails.RelationReference, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "BookingFailure.aspx";

                                        }
                                    }
                                    else
                                    {
                                        //lstrResponse = "/PointGateway.aspx?flag=KhaltiAir";
                                        lstrResponse = "BookingFailure.aspx";
                                    }
                                }
                                else if (lstrBookingFlag.ToLower().Equals("flight"))
                                {
                                    if (lobjOTPDetails != null)
                                    {
                                        List<RedemptionDetails> lobjListOfRedemptionDetails = HttpContext.Current.Session["RedemptionDetails"] as List<RedemptionDetails>;
                                        RedemptionDetails lobjRedemptionDetails = lobjListOfRedemptionDetails[0];
                                        Status = lobjmodel.SendOTPEmailAndSMS(lobjMemberDetails, "redemption_otp", lobjOTPDetails, "International Flight");

                                        if (Status)
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "AIR", lobjRedemptionDetails.RelationReference, "Success"), ActivityType.ReviewConfirmOTPSuccess);
                                            lstrResponse = "ValidateOTP.aspx?flag=Air";
                                        }
                                        else
                                        {
                                            lobjmodel.LogActivity(string.Format(ActivityConstants.ReviewConfirmOTP, "AIR", lobjRedemptionDetails.RelationReference, "Failed"), ActivityType.ReviewConfirmOTPFailed);
                                            lstrResponse = "BookingFailure.aspx";

                                        }
                                    }
                                    else
                                    {
                                        //lstrResponse = "/PointGateway.aspx";
                                        lstrResponse = "BookingFailure.aspx";
                                    }
                                    
                                }
                            }
                            else
                            // redirect to cards payment(Points + Cash Payment)
                            {
                                lobjStripePaymentDetails.PaymentType = PaymentType.CashPoints;
                                HttpContext.Current.Session["StripePaymentDetails"] = lobjStripePaymentDetails;
                                lstrResponse = "PaymentReviewConfirm.aspx";
                            }
                        }
                        else
                        {
                            lobjStripePaymentDetails.PaymentType = PaymentType.Cash;
                            HttpContext.Current.Session["StripePaymentDetails"] = lobjStripePaymentDetails;
                            lstrResponse = "PaymentReviewConfirm.aspx";
                        }
                    }
                    else
                    {
                        lobjStripePaymentDetails.ReqRedeemPoint = "0";
                        HttpContext.Current.Session["StripePaymentDetails"] = lobjStripePaymentDetails;
                        lstrResponse = "Insuficient_Balance";

                        //lstrResponse = "Insuficient_Balance";
                    }


                    lobjmodel.LogActivity(string.Format(ActivityConstants.PaymentConsentLoyalty, lintActualProductPoints, lintSelectedRedeemPoints, lstrResponse), ActivityType.Payment);

                }

            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("PaymentOptions PaymentConsentLoyalty Ex-:" + ex.InnerException + ex.StackTrace + ex.Message);
        }
        return lstrResponse;
    }

    private static string Encrypt(string clearText)
    {
        try
        {
            string EncryptionKey = "MAKV2SPNIC99212";
            byte[] clearBytes = Encoding.Unicode.GetBytes(clearText);
            using (Aes encryptor = Aes.Create())
            {
                Rfc2898DeriveBytes pdb = new Rfc2898DeriveBytes(EncryptionKey, new byte[] { 0x49, 0x76, 0x61, 0x6e, 0x20, 0x4d, 0x65, 0x64, 0x76, 0x65, 0x64, 0x65, 0x76 });
                encryptor.Key = pdb.GetBytes(32);
                encryptor.IV = pdb.GetBytes(16);
                using (MemoryStream ms = new MemoryStream())
                {
                    using (CryptoStream cs = new CryptoStream(ms, encryptor.CreateEncryptor(), CryptoStreamMode.Write))
                    {
                        cs.Write(clearBytes, 0, clearBytes.Length);
                        cs.Close();
                    }
                    clearText = Convert.ToBase64String(ms.ToArray());
                }
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("ProductDetails.aspx Encrypt Exception: " + ex.Message + Environment.NewLine + ex.InnerException + Environment.NewLine + ex.StackTrace);
        }
        return clearText;
    }
}