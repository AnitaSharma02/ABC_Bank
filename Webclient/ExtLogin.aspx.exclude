            <div class="clr"></div>
            <div class="footer">

                <div class="ftr">


                    <div class="col-xs">
                        <p>Follow us on:</p>

                        <ul class="list-inline">
                            <li><a href="http://www.youtube.com/user/qibgroup" target="_blank">
                                <img src="images/soc_ytube.png" /></a></li>
                            <li><a href="https://instagram.com/qibgroup" target="_blank">
                                <img src="images/Instagram-new2.png" /></a></li>
                            <li><a href="https://www.twitter.com/qibgroup" target="_blank">
                                <img src="images/soc_tw.png" /></a></li>
                            <li><a href="https://linkedin.com/company/qib" target="_blank">
                                <img src="images/soc_link.png" /></a></li>
                            <li><a href="https://www.facebook.com/qibgroup" target="_blank">
                                <img src="images/soc_fb.png" /></a></li>

                        </ul>
                    </div>
                    <div class="socico">
                        <p>
                            <a href="http://infiniasns.com/" target="_blank">
                                <img src="Images/inifi-logo.png" /></a>
                        </p>
                    </div>
                </div>
                <div class="clr"></div>
                <div class="ftrmenu" id="MainNav">
                    <ul id="nav">
