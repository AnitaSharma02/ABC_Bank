public partial class ExtLoginSSO : System.Web.UI.Page
{
    protected void Page_Load(object sender, EventArgs e)
    {
        string lstrPostData = string.Empty;
        string lstrPostDecyptData = string.Empty;
        string lstrRedirectURL = string.Empty;

        try
        {
            using (StreamReader sr = new StreamReader(Request.InputStream))
            {
                lstrPostData = sr.ReadToEnd();
            }

            LoggingAdapter.WriteLog("ExtLoginSSO2  PostData = " + lstrPostData);

            if (lstrPostData != null && lstrPostData != string.Empty)
            {
                var js = new System.Web.Script.Serialization.JavaScriptSerializer();
                Dictionary<string, string> objData = js.Deserialize<Dictionary<string, string>>(lstrPostData);
                lstrPostDecyptData = objData["Merchant_Details"];

                LoggingAdapter.WriteLog("ExtLoginSSO2  PostDecyptData = " + lstrPostDecyptData);

                Session["SSOErrorMessage"] = null;
                divExtSSO.Attributes.Add("style", "display:block");
                Session["MemberDetails"] = null;

                int KeySize = 2048;
                string PrivateKey = string.Empty;

                if (Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["ExtLoginSSOType"]) == "UAT")
                {
                    PrivateKey = "<RSAKeyValue><Modulus></Modulus><Exponent>AQAB</Exponent><P>1Gg2LX8OPUA8Xt2jhcgs/DEicU1jNtZwPh1QT2a71txBKsTQcyMA+iHd3m/61ix9KhnXPpM/kYEK2IqHOIUY4jUsjc+Ha3jtbjXnXm9bvuq9R4uFuztOAzdbJEWd32bCD3ueeoH6C1/BKCW+4Rg2PILRtO8wpj+QXGFGmKq1MHE=</P><Q>yUgFwMaO1lezn3cp2hm5yZSfzL4yip21BMN3Wo1ZfSC+LFvMmgAhf8WobZATRLePE7Gg86D6K2IGDlkPLRS5TvBBxisuLN5pyJEDxsmtkS396oZOurRgd9xVvMH9s/cruWFpO27PLUzf3lPGH+ejC6UPJTla7ymH/MdIlc+vofc=</Q><DP>KDvtN0T/735BcT7OgMLgMo0kFw4vou2PqVRoKAIvxo1GEtHhIk4ZG0ha/I19mCApPVZTvVirC+bDpSzoXD5p7j9gRyRuZF8tqlivkOXLHSjd3bWCCWs8ZcOQkhhVxUFztPcXl+ES+iCTOAWeWIj7jQ7CpmFAd91GfRk4BCch1yE=</DP><DQ>GrRihwQQ+WEjZLnTpKsbGiKM3QYzAG8SEDK6yBnO0KoicRIw4BG6YBBiWz7tP4W3Bt7fQtONvWnA8fBg8hM4zr9Tiq457xwHHuQWgy5Ix+U5Nf9hvKWn0t85xNRcC590fqDs7ES0WgdEAGRO+faqjCX3D3I/nVF+SExMVgv6+ls=</DQ><InverseQ>sTeLDNDPBHsyNUmP+XUiGhdo5Uuvwqz/t6hEOJabaa3Cwrugtbt5Mk1DWZJSeTxP1ZXCna+Run1UwSrLUwMxT8FtfS0SvtNLzWws4fnhkzReLoMr6hIkvyYJjtFCbxmbwTvkdmrzYOkE8c4WekFVrUan6RrWuOawnRix5q2f7Ac=</InverseQ><D></D></RSAKeyValue>";
                }
                else
                {
                    PrivateKey = "";
                }

                string lstrEncryptedData = string.Empty;
                string lstrDecryptData = string.Empty;
                string lstrMemberCIF = string.Empty;
                string[] DataList = new string[] { };
                string lstrMessage = string.Empty;
                //lstrEncryptedData = Request.Form["Merchant_Details"];
                //lstrEncryptedData = Request.Form["Merchant_Details"];

                lstrEncryptedData = lstrPostDecyptData;

                ABCModel lobjQIBModel = new ABCModel();
                MemberDetails lobjMemberDetails = new MemberDetails();

                LoggingAdapter.WriteLog("ExtLoginSSO2  Encrypted Data = " + lstrEncryptedData);
                lstrDecryptData = RSAEncryptor.DecryptString(lstrEncryptedData, KeySize, PrivateKey);
                LoggingAdapter.WriteLog("ExtLoginSSO2  after Decrypt = " + lstrDecryptData);

                if (lstrDecryptData != null || lstrDecryptData != "")
