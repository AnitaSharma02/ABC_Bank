                                    LoggingAdapter.WriteLog("ExtLoginSSO2  Member Details not null -" + lstrMemberCIF);
                                    MemberRelation lobjMemberRelation = new MemberRelation();
                                    lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));

                                    if (lobjMemberRelation.Status != Status.Cancelled)
                                    {
                                        LoggingAdapter.WriteLog("ExtLoginSSO2  Member Relation not null and status not equal to cancel ");
                                        if (lobjMemberRelation.Status != Status.Suspended)
                                        {
                                            LoggingAdapter.WriteLog("ExtLoginSSO2  Member Relation not null and status not equal to suspend ");

                                            if (lobjMemberRelation.Status != Status.Blocked)
                                            {
                                                LoggingAdapter.WriteLog("ExtLoginSSO2  Member Relation not null and status not equal to blocked ");

                                                if (lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS)).IsAccountActivated)
                                                {
                                                    //disable shop for ExtSSO login
                                                    Control myControlMenu = Page.Master.FindControl("icoshop");
                                                    if (myControlMenu != null)
                                                    {
                                                        myControlMenu.Visible = false;
                                                    }

                                                    MemberActivitySession lobjMemberActivitySession = HttpContext.Current.Session["MemberActivitySession"] as MemberActivitySession;
                                                    lobjMemberActivitySession.ReferenceNumber = lstrMemberCIF;
                                                    lobjMemberActivitySession.ActivityType = ActivityType.loginsuccessful;
                                                    bool isMembershipUpdated = lobjQIBModel.UpdateMemberShipActivitySession(lobjMemberActivitySession);
                                                    lobjQIBModel.LogActivity(string.Format(ActivityConstants.Login, lstrMemberCIF, "ExtSSO login successful"), ActivityType.loginsuccessful);

                                                    LoggingAdapter.WriteLog("ExtLoginSSO2  Member Relation not null and account is activated ");
                                                    Session["MemberDetails"] = lobjMemberDetails;

                                                    Session["FromSSOLogin"] = "1";

                                                    string lstExtLoginSSORedirectURL = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["ExtLoginSSORedirectURL"]);

                                                    LoggingAdapter.WriteLog("ExtLoginSSO2 EXtSSO 2 Post Success-" + lstExtLoginSSORedirectURL);

                                                    //Response.Redirect(lstExtLoginSSORedirectURL, false);
                                                    lstrRedirectURL = lstExtLoginSSORedirectURL + "?applogin=true";
                                                }
                                                else
                                                {
                                                    LoggingAdapter.WriteLog("ExtLoginSSO2  Member Relation not null and account is InActivated ");
                                                    Session["SSOErrorMessage"] = "Error - Your account has been InActivated. Please activate your account.";
                                                    //Response.Redirect("InvalidCredential.aspx", false);
                                                    lstrRedirectURL = "InvalidCredential.aspx";
                                                }
                                            }
                                            else
                                            {
                                                LoggingAdapter.WriteLog("ExtLoginSSO2  8");
                                                Session["SSOErrorMessage"] = "Error - Your account has been blocked, kindly visit your nearest branch";
                                                //Response.Redirect("InvalidCredential.aspx", false);
                                                lstrRedirectURL = "InvalidCredential.aspx";
                                            }

                                        }
                                        else
                                        {
                                            LoggingAdapter.WriteLog("ExtLoginSSO2  8");
                                            Session["SSOErrorMessage"] = "Error - Your account has been suspended, kindly visit your nearest branch";
                                            //Response.Redirect("InvalidCredential.aspx", false);
                                            lstrRedirectURL = "InvalidCredential.aspx";
                                        }
                                    }
                                    else
                                    {
                                        LoggingAdapter.WriteLog("ExtLoginSSO2  9");
                                        Session["SSOErrorMessage"] = "Error - Your QIBRewards account has been cancelled, kindly visit your nearest branch";
                                        //Response.Redirect("InvalidCredential.aspx", false);
                                        lstrRedirectURL = "InvalidCredential.aspx";
                                    }
                                }
                                else
                                {
                                    LoggingAdapter.WriteLog("ExtLoginSSO2  10");
                                    Session["SSOErrorMessage"] = "Error - Kindly Check CIF with Bank.";
                                    //Response.Redirect("InvalidCredential.aspx", false);
                                    lstrRedirectURL = "InvalidCredential.aspx";
                                }
                            }
                            else
                            {
                                LoggingAdapter.WriteLog("ExtLoginSSO2  11");
                                Session["SSOErrorMessage"] = "Error - Technical Error. Please try again later.";
                                //Response.Redirect("InvalidCredential.aspx", false);
                                lstrRedirectURL = "InvalidCredential.aspx";
                            }
                        }
                        else
                        {
                            LoggingAdapter.WriteLog("ExtLoginSSO2  12");
                            Session["SSOErrorMessage"] = "Error - Technical Error. Please try again later.";
                            //Response.Redirect("InvalidCredential.aspx", false);
                            lstrRedirectURL = "InvalidCredential.aspx";
                        }
                    }
                    else
                    {
                        LoggingAdapter.WriteLog("ExtLoginSSO2  13");
                        Session["SSOErrorMessage"] = "Error - Technical Error. Please try again later.";
                        //Response.Redirect("InvalidCredential.aspx", false);
                        lstrRedirectURL = "InvalidCredential.aspx";
                    }
                }
                else
                {
                    LoggingAdapter.WriteLog("ExtLoginSSO2  14");
                    Session["SSOErrorMessage"] = "Error - Technical Error. Please try again later.";
                    //Response.Redirect("InvalidCredential.aspx", false);
                    lstrRedirectURL = "InvalidCredential.aspx";
                }
            }
            else
            {
                LoggingAdapter.WriteLog("ExtLoginSSO2  18");
                Session["SSOErrorMessage"] = "Error - Sorry we could not process your request. Please Try again.";
                //Response.Redirect("InvalidCredential.aspx", false);
                lstrRedirectURL = "InvalidCredential.aspx";
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("ExtLoginSSO2  15");
            Session["SSOErrorMessage"] = "Error - Sorry we could not process your request. Please Try again.";
            LoggingAdapter.WriteLog("ExtLoginSSO2  Ex -" + ex.Message + Environment.NewLine + "Stack Trace-" + ex.StackTrace + ex.InnerException);
            //Response.Redirect("InvalidCredential.aspx", false);
            lstrRedirectURL = "InvalidCredential.aspx";
        }
        finally
        {
            LoggingAdapter.WriteLog("ExtLoginSSO2 Finally URL-" + lstrRedirectURL);

            if (Session["MemberDetails"] != null)
                LoggingAdapter.WriteLog("ExtLoginSSO2 Finally MemberDetails Not Null");

            Response.Redirect(lstrRedirectURL);
        }
