                            }
                        }

                        LoggingAdapter.WriteLog("ExtLoginSSO2  Md5EncyrptHashReq = " + sb.ToString());

                        string Md5EncyrptHash = EncryptStringMD5(sb.ToString());

                        LoggingAdapter.WriteLog("ExtLoginSSO2  Md5EncyrptHashRes = " + Md5EncyrptHash);

