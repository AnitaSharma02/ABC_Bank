<%@ Page Language="C#" AutoEventWireup="true" CodeFile="CarList.aspx.cs" Inherits="CarList"
    MasterPageFile="~/SiteMaster.master" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">
    <link href="Css/jquery.ui.datepicker.css" type="text/css" rel="stylesheet" />
    <link href="Css/dropDown.css" type="text/css" rel="stylesheet" />
    <link href="Css/Car.css" type="text/css" rel="stylesheet" />
    <script src="Jquery/CarResultScript.js" type="text/javascript"></script>
    <script src="Jquery/JTemplateCreator.js" type="text/javascript"></script>
    <script src="Jquery/JSCarFillMethods.js" type="text/javascript"></script>
    <script src="Jquery/CarSearchLoad.js" type="text/javascript"></script>
    <script src="Jquery/jquery.selectric.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var edit = getUrlVars()["edit"];
            if (edit == "1") {
                $('#modify_search').addClass('show');
            }
            $('#btnfliter').click(function () {
                $('#divSearch').addClass('MoveLeft');
                $('#divSearch').show();
                $('#divBlockAll').css('display', 'block');
                $('#divBlockAll').show();
                $('#divSearch').stop().animate({ 'left': '0px' }, 500);
                return false;
            });
            $('#divBlockAll').click(function () {
                $('#divBlockAll').hide();
                $('#divSearch').stop().animate({ 'left': '-768px' }, 200);

            });
        });
        function getUrlVars() {
            var vars = [], hash;
            var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for (var i = 0; i < hashes.length; i++) {
                hash = hashes[i].split('=');
                vars.push(hash[0]);
                vars[hash[0]] = hash[1];
            }
            return vars;
        }

        //for returning to back page 
        document.getElementsByClassName("btnBack").onclick = function () {
        location.href = "/CarSearch.aspx";
        };
    </script>
    <script type="text/javascript">

        $(document).ready(function () {
            //GetCarData();
            GetCarList();

            $('.modify').click(function () {
                $('.modify-box').toggle();
            });
            showModifyCar();

            var lddlDropCountryFilled = 0;
            var ddllCountry = $('#CP_DDLCountry');
            var ddllCity = $('#CP_ddlCityMobile');
            var ddllLocation = $('#CP_ddlLocationMobile');
            var ddllDropCountry = $('#CP_ddlDropCountryMobile');
            var ddllDropCity = $('#CP_ddlDropCityMobile');
            var ddllDropLocation = $('#CP_ddlDropLocationMobile');
            var chkDropLocation = $('#CP_droploctionMobile');
            var divddlDrop = $('#divDropddlMobile');
            var ltrDriverAge = $('#trDriverAge');
            divddlDrop.hide();
            ltrDriverAge.hide();
            //ToggleModifySearch();
            $(".datepicker").datepicker('disable');

            $('#txtDropOffDate').datepicker({
                minDate: minimumtime(),
                numberOfMonths: 2,
                dateFormat: 'dd/mm/yy'
            });


            ddllCountry
                .on('change', function () {

                    if ($(this).val() == 'more') {
                        //                    BindGlobalCountryList(ddllCountry, $("#CP_DivCarErrorMobile"));
                        BindGlobalCountryList(ddllCountry, ddllCity, ddllLocation, 'select')
                    }
                    else {
                        BindGlobalCityList(ddllCity, ddllLocation, ddllCountry.find('option:selected').text(), '')
                    }
                });

            ddllCity
                .on('change', function () {
                    BindGlobalLocationList(ddllCountry.find('option:selected').text(), ddllCity.find('option:selected').text(), ddllLocation, '');
                });

            ddllDropCity
                .on('change', function () {
                    BindGlobalLocationList(ddllDropCountry.find('option:selected').text(), ddllDropCity.find('option:selected').text(), ddllDropLocation, '');
                });

            ddllLocation
                .on('change', function () {
                    $('#hdnLocationId').val($(this).val());
                    $(".datepicker").datepicker('enable');
                    // PickUpLocationChange(DDLCountry.find('option:selected'), ddllDropCity.find('option:selected').text(), ddllDropLocation, '');
                    PickUpLocationChange($('#CP_DDLCountry option:selected'), $('#CP_DDlCity option:selected'), $('#CP_DDLLocation option:selected'), $('#CP_ddlDropCountry'), $('#CP_ddlDropCity'), $('#CP_ddlDropLocation'));
                });

            ddllDropLocation
                .on('change', function () {
                });


            chkDropLocation.click(function () {
                if (this.checked) {
                    divddlDrop.hide();
                }
                else {
                    divddlDrop.show()
                }
            });

            $('#CP_chkDriverMobile').click(function () {
                if (this.checked) {
                    $('#trDriverAge').hide();
                }
                else {
                    $('#trDriverAge').show();
                }
            });

            $('#lnkFilterMoile').click(function () {
                $('#divModifySearch').hide();
                $('#divCustomizesarch').hide();
                $('#btnPlusModifysearch').attr('src', 'Images/drop1.png');
                $('#btnPlusCustomizesearch').attr('src', 'Images/drop1.png');

                $('#divSearch').removeClass('flight-left-m3');
            });
           
            //End of assigning events
            $('#ddlCityMobile').attr('disabled', true);
            $('#ddlLocationMobile').attr('disabled', true);
            $('#CP_DivCarErrorMobile').hide();
            $('#txtPickUpDate').attr('disabled', true);
            $('#txtDropOffDate').attr('disabled', true);
        });

        function showModifyCar() {

            $.ajax({
                type: 'POST',
                url: 'CarList.aspx/ModifySearchData',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: "",
                async: false,
                success: function (msg) {

                    var objModifySerachRequest = $.parseJSON(msg.d[0]);
                    var objModifySerachResponse = $.parseJSON(msg.d[1]);
                    BindGlobalCountryList($('#CP_DDLCountry'), $('#CP_DDlCity'), $('#CP_DDLLocation'), objModifySerachRequest.SearchRequest.PickUp[0].Location[0].country);
                    BindGlobalCityList($('#CP_DDlCity'), $('#CP_DDLLocation'), objModifySerachRequest.SearchRequest.PickUp[0].Location[0].country, objModifySerachRequest.SearchRequest.PickUp[0].Location[0].city, "true");
                    BindGlobalLocationList(objModifySerachRequest.SearchRequest.PickUp[0].Location[0].country, objModifySerachRequest.SearchRequest.PickUp[0].Location[0].city, $('#CP_DDLLocation'), $.trim(objModifySerachRequest.SearchRequest.PickUp[0].Location[0].locName), "true");

                    BindDropOffCountry($('#CP_ddlDropCountry'), $('#CP_ddlDropCity'), $('#CP_ddlDropLocation'), objModifySerachRequest.SearchRequest.DropOff[0].Location[0].country, "true");
                    BindDropOffCity($('#CP_ddlDropCity'), $('#CP_ddlDropLocation'), objModifySerachRequest.SearchRequest.DropOff[0].Location[0].country, objModifySerachRequest.SearchRequest.DropOff[0].Location[0].city, "true");
                    DropoffCityChange(objModifySerachRequest.SearchRequest.DropOff[0].Location[0].country, objModifySerachRequest.SearchRequest.DropOff[0].Location[0].city, $('#CP_ddlDropLocation'), $.trim(objModifySerachRequest.SearchRequest.DropOff[0].Location[0].locName), "true")


                    if (objModifySerachRequest.SearchRequest.DropOff[0].Location[0].id == objModifySerachRequest.SearchRequest.PickUp[0].Location[0].id) {

                        $('#CP_droploction').attr('checked', true);
                        $('.divDropContainer').hide();
                    }
                    else {
                        $('#CP_droploction').prop('checked', false);
                        $('.divDropContainer').show();
                        //debugger;
                        // PickUpLocationChange($('#CP_DDLCountry option:selected'), $('#CP_DDlCity option:selected'), $('#CP_DDLLocation option:selected'), $('#CP_ddlDropCountry'), $('#CP_ddlDropCity'), $('#CP_ddlDropLocation'));
                    }


                    var splitFromTime = msg.d[2].split(',');
                    var splitToTime = msg.d[3].split(',');

                    $("#CP_hdnddlFromTime").val(splitFromTime);
                    $("#CP_hdnddlToTime").val(splitToTime);

                    $('#CP_ddlFromTime').selectric('destroy');

                    for (var i = 0; i < splitFromTime.length; i++) {
                        splitFromTime[i] = splitFromTime[i].replace(/^\s*/, "").replace(/\s*$/, "");
                        if (objModifySerachRequest.SearchRequest.PickUp[0].Date[0].hour == splitFromTime[i]) {
                            $('#CP_ddlFromTime').append('<option selected="selected">' + splitFromTime[i] + '</option>');
                        }
                        else {
                            $('#CP_ddlFromTime').append('<option>' + splitFromTime[i] + '</option>');
                        }
                    }

                    $('#CP_ddlDropFromTime').selectric('destroy');
                    for (var i = 0; i < splitToTime.length; i++) {
                        splitToTime[i] = splitToTime[i].replace(/^\s*/, "").replace(/\s*$/, "");
                        if (objModifySerachRequest.SearchRequest.DropOff[0].Date[0].hour == splitToTime[i]) {
                            $('#CP_ddlDropFromTime').append('<option selected="selected">' + splitToTime[i] + '</option>');
                        }
                        else {
                            $('#CP_ddlDropFromTime').append('<option>' + splitToTime[i] + '</option>');
                        }
                    }

                    $('#CP_CarTextBoxCheckin').val(objModifySerachRequest.SearchRequest.PickUp[0].Date[0].day + "/" + objModifySerachRequest.SearchRequest.PickUp[0].Date[0].month + "/" + objModifySerachRequest.SearchRequest.PickUp[0].Date[0].year)



                    $('#CP_ddlMinFrom').selectric('destroy');
                    //  $('#CP_ddlMinFrom').append('<option selected="selected" value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>');
                    $('#CP_ddlMinFrom').val(objModifySerachRequest.SearchRequest.PickUp[0].Date[0].minute);
                    $('#CP_CarTextBoxCheckout').val(objModifySerachRequest.SearchRequest.DropOff[0].Date[0].day + "/" + objModifySerachRequest.SearchRequest.DropOff[0].Date[0].month + "/" + objModifySerachRequest.SearchRequest.DropOff[0].Date[0].year)

                    $('#CP_ddlDropMinFrom').selectric('destroy');
                    // $('#CP_ddlDropMinFrom').append('<option selected="selected" value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>');
                    $('#CP_ddlDropMinFrom').val(objModifySerachRequest.SearchRequest.DropOff[0].Date[0].minute);


                    $('#CP_ddlDropMinFrom,#CP_ddlMinFrom,#CP_ddlFromTime,#CP_ddlDropFromTime').selectric({
                        maxHeight: 100,
                        disableOnMobile: false,
                        responsive: true
                    });
                }
            });
        }

</script>
     <!--jQuery to hide filter popup div-->
		<script type="text/javascript">
            $(document).ready(function () {
                $("#btnClosePopup").click(function () {
                    $("#divSearch").hide();
                });
            });
		</script>
    <div class="innerPages">
        <div class="container SearchDetail mt-3 my-3">
            <span class="Content_Style" id="spnSearchdetail"></span>
            <a href="#modify_search" id="btnModify" class="float-right blue_button1" data-toggle="collapse" data-i18n="flightlist-modify">Modify</a>
            <a class="blue_button1" id="btnfliter" data-i18n="button-filters">Filters</a>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <div id="divSearch" class="filter">
                        <div class="innerBox">
                            <div class="flt-left">
                                <h3 ><span data-i18n="carlist-total">Total Car(s) Found:</span>  <label id="TotalCarCount"></label></h3>
                               
                                <hr />
                                <h3 data-i18n="car-car-class">Car Class</h3>
                                <div class="airList">
                                    <ul class="mTop5" id="divCarType"></ul>
                                </div>
                                <hr />
                                <h3 data-i18n="car-car-conditioning">Car Conditioning</h3>
                                <div class="airList">
                                    <ul class="mTop5" id="divCarClass"></ul>
                                </div>
                                <hr />
                                <h3 class="heading" data-i18n="car-car-transmission">Car Transmission</h3>
                                <div class="airList">
                                    <ul class="mTop5" id="divCarTransmission"></ul>
                                </div>
                                
                            </div>
                             <div class="clear"></div>
                                <div class="applyBtn" style="display:none;">
                                    <button type="button" id="btnClosePopup" class="apply_button Search hvr-sweep-to-right" value="Apply">Apply</button>
                                </div>
                            <div id="divBlockAll"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="innerBox serviceWidget collapse" id="modify_search">
                        <div id="divcar" class="srchpanel">
                            <!--Car Search Panel Start -->
                        <div id="CarValidationError" runat="server" class="Searchvalid"></div>
					    <div class="form_box carBlk">
							<div class="row mb-3">
								<div class="col-md-4">
									<label data-i18n="car-country-label">Country</label> 
									<div class="select_box dropDown">
										<select id="DDLCountry" runat="server" class="form-control">
											<option selected="selected" value="Select Country" data-i18n="car-country-input">Select Country</option>
											<option value="Austria">Austria</option>
											<option value="France">France</option>
											<option value="Greece">Greece</option>
											<option value="India">India</option>
											<option value="Qatar">Qatar</option>
											<option value="Russia">Russia</option>
											<option value="Saudi">Saudi Arabia</option>
											<option value="more">Load all countries...</option>
                                    </select>
									</div>
								</div>
								<div class="col-md-4">
									<label data-i18n="car-city-label">City</label>
									<div class="select_box dropDown">
										<select id="DDlCity" runat="server" class="form-control">
											<option selected="selected" value="Select City">Select City</option>
										</select>
									</div>
								</div>
								<div class="col-md-4">
									<label data-i18n="car-location-label">Location</label>
									<div class="select_box dropDown">
										<select id="DDLLocation" runat="server" class="form-control">
											<option selected="selected" value="Select Location">Select Location</option>
										</select>
									</div>
								</div>
							</div>
							<div class="row mb-3 divDropContainer">
								<div class="col-md-4">
									<label data-i18n="car-country-label">Country</label>
									<div class="select_box dropDown">
										<select id="ddlDropCountry" runat="server" class="form-control">
											<option selected="selected" value="Select Country" data-i18n="car-country-input">Select Country</option>
											<option value="Austria">Austria</option>
											<option value="France">France</option>
											<option value="Greece">Greece</option>
											<option value="India">India</option>
											<option value="Qatar">Qatar</option>
											<option value="Russia">Russia</option>
											<option value="Saudi">Saudi Arabia</option>
											<option value="more">Load all countries...</option>
                                    </select>
									</div>
								</div>
								<div class="col-md-4">
									<label data-i18n="car-city-label">City</label>
									<div class="select_box dropDown">
										<select id="ddlDropCity" runat="server" class="form-control">
											<option selected="selected" value="Select City" data-i18n="car-city-input">Select City</option>
										</select>
									</div>
								</div>
								<div class="col-md-4">
									<label data-i18n="car-location-label">Location</label>
									<div class="select_box dropDown">
										<select id="ddlDropLocation" runat="server" class="form-control">
											<option selected="selected" value="Select Location" data-i18n="car-location-input">Select Location</option>
										</select>
									</div>
								</div>
							</div>
							<div class="row mb-3">
								<div class="col-md-6">									
									<div class="row">
										<div class="col-md-6">
											<label data-i18n="car-pick-up-Date-label">Pick-Up Date</label>
											<div class="input-group">
												<input class="input datePicker form-control" value="Enter Date" onfocus="placeholderOnFocus(this, $.i18n('car-pick-up-Date-input'));"
                                                onblur="placeholderOnFocus(this, $.i18n('car-pick-up-Date-input'));" type="text" id="CarTextBoxCheckin" runat="server" readonly="readonly" />
											</div>
										</div>
                                        <div class="col-md-6">
                                            <label data-i18n="car-pick-up-time-label">Pick-Up Time</label>  
                                            <div class="row">
										    <div class="col-6">
											<div class="select_box selTime">
												<select class="dropdown-select down-arrow form-control" id="ddlFromTime" runat="server">
													<option value="0" selected="selected">00</option>
												</select>
											</div>
										</div>
										    <div class="col-6">
											<div class="select_box selTime">
												<select class="form-control" id="ddlMinFrom" runat="server">
													<option selected="selected" value="00">00</option>
													<option value="15">15</option>
													<option value="30">30</option>
													<option value="45">45</option>
												</select>
											</div>
										</div>
                                        </div>
                                        </div>
									</div>
								</div>
								<div class="col-md-6">									
									<div class="row">
										<div class="col-md-6">
											<label data-i18n="car-drop-Off-date-label">Drop-Off Date</label>
											<div class="input-group">
												<input class="input datePicker form-control" value="Enter Date" onfocus="placeholderOnFocus(this, $.i18n('car-drop-Off-date-input'));"
                                                onblur="placeholderOnFocus(this, $.i18n('car-drop-Off-date-input'));" type="text" id="CarTextBoxCheckout" runat="server" readonly="readonly" />
											</div>
										</div>
										<div class="col-md-6">
                                            <label data-i18n="car-drop-Off-time-label">Drop-Off Time</label>
                                            <div class="row">
                                            <div class="col-6">
											<div class="select_box selTime">
												<select class="dropdown-select down-arrow form-control" id="ddlDropFromTime" runat="server">
													<option value="0" selected="selected">00</option>
												</select>
											</div>
										</div>
										    <div class="col-6">
											<div class="select_box selTime">
												<select class="form-control" id="ddlDropMinFrom" runat="server">
													<option selected="selected" value="00">00</option>
													<option value="15">15</option>
													<option value="30">30</option>
													<option value="45">45</option>
												</select>
											</div>
										</div>
										    <asp:HiddenField ID="HiddenField1" runat="server" />
                                            <asp:HiddenField ID="HiddenField2" runat="server" />
                                            </div>
                                        </div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-8">
                                    <div class="row">
                                <div class="col-md-12 valignM">
									<input id="droploction" value="1" runat="server" checked="checked" type="checkbox"> <label style="vertical-align: middle;" data-i18n="car-return-label">Return to same location</label>
								</div>
								<div class="col-md-12 valignM">
									<input id="chkDriver" type="checkbox" value="1" runat="server" checked="checked" /> <label style="vertical-align: middle;" data-i18n="car-driver-label">Driver aged between 25-70 Years?</label>
									<asp:TextBox ID="txtDiverAge" runat="server" Text="25"  Width="10%" onfocus="placeholderOnFocus(this,'Enter Date');"
