<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true" CodeFile="ParterElectronics.aspx.cs" Inherits="ParterElectronics" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" Runat="Server">
    <style>
        .brd-crms {display:none;}
    </style>
    <div class="container">
        <div class="row">
            <div class="col-12 voucher-partner-blk">
                <h2>Electronics Partners</h2>
                <ul>
                    <li><a class="btn" data-toggle="modal" data-target="#myModal1"><img src="../Images/img-vou-electronics.jpg" /></a><p>Electronics</p></li>
                    <li><a href="#"><img src="../Images/img-vou-depatmental-store.jpg" /></a><p>Department Stores</p></li>
                    <li><a href="#"><img src="../Images/img-vou-fashion-accessories.jpg" /></a><p>Fashion & Accessories</p></li>
                    <li><a href="#"><img src="../Images/img-vou-travel-agency.jpg" /></a><p>Travel Agency</p></li>
                    <li><a href="#"><img src="../Images/img-vou-dining.jpg" /></a><p>Dining</p></li>
                </ul>
                <!-- Modal ST -->
                <div class="modal fade comDetail" id="myModal1" role="dialog">
                    <a class="close" data-dismiss="modal"><img src="../Images/close.png" /></a>
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body row">
                                <div class="col-md-3"><img src="../Images/img-vou-electronics.jpg" style="width: 100%;" /></div>
                                <div class="col-md-9">
                                    <h2>Virgin Megastore</h2>
                                    <p>Hartland's Water Canal Villas form a thriving community that overlooks the sparkling blue waters of one of Dubai's most iconic destinations, only steps away from the Dubai Water Canal a vibrant promenade, spoiling the residents with boundless dining, retail and entertainment experiences. Designed for a sophisticated and luxurious living experience with ample space, multiple levels and high-ceilinged interiors.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Modal ED -->
            </div>
        </div>
    </div>
</asp:Content>

