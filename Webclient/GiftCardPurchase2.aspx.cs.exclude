using Framework.EnterpriseLibrary.Adapters;
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Web;
using System.Web.Services;
using System.Web.UI;
using System.Web.UI.WebControls;
using ABC.Model;
using Giift.Integration.Client.Entities;
using Giift.Integration.Client.Helper;
using Core.Platform.Helper.ProgramName;
using Core.Platform.ProgramMaster.Entities;
using System.Configuration;
using Core.Platform.Member.Entites;
using Core.Platform.Transactions.Entites;
using Core.Platform.PointGateway.Service.Helper;
using Newtonsoft.Json;

public partial class GiftCardPurchase2 : System.Web.UI.Page
{
    ABCModel lobjmodel = new ABCModel();
    string lstrGiftCardId = string.Empty;
    string lstrAuthToken = string.Empty;
    string lstrLocale = "en";

    protected void Page_Load(object sender, EventArgs e)
    {
        if (!Page.IsPostBack)
        {
            if (!Page.IsPostBack)
            {
                if (!string.IsNullOrEmpty(Request.QueryString["CardId"]))
                {
                    lstrGiftCardId = Convert.ToString(Request.QueryString["CardId"]);
                    //
                    if (Request.QueryString["Locale"] != null)
                    {
                        lstrLocale = Convert.ToString(Request.QueryString["Locale"]);
                    }

                    if (Session["MemberDetails"] == null)
                    {
                        string CallbackUrl = HttpUtility.UrlEncode(Encrypt("GiftCardPurchase.aspx?CardId=" + lstrGiftCardId + "&Locale=" + lstrLocale));
                        Response.Redirect("Login.aspx?CallbackUrl=" + CallbackUrl);
                    }
                }
                else
                {
                    Response.Redirect("GiftCards2.aspx");
                }
            }
        }
    }

    [WebMethod]
    public static object GetCardDetails(string cardId, string locale)
    {
        CHelper lobjCHelper = new CHelper();
        object lstrResponse = null;

        try
        {
            string lstrProgramName = ProgramHelper.ProgramName();
            //
            ABCModel lobjmodel = new ABCModel();
            ProgramDefinition lobjProgramDefinition = lobjmodel.GetProgramDetails(lstrProgramName);
            //
            string lstrCurrency = lobjmodel.GetDefaultCurrency();
            string lstrGCCurrency = Convert.ToString(ConfigurationManager.AppSettings["GCCurrency"]);

            if (HttpContext.Current.Session["AuthToken"] != null)
            {
                string lstrAuthToken = Convert.ToString(HttpContext.Current.Session["AuthToken"]);
                GiftCard lobjGiftCard = null;

                GiftCardRequest lobjGiftCardRequest = new GiftCardRequest();
                lobjGiftCardRequest.Username = Convert.ToString(ConfigurationManager.AppSettings["GCUserName"]);
                lobjGiftCardRequest.Password = Convert.ToString(ConfigurationManager.AppSettings["GCPassword"]);
                lobjGiftCardRequest.PointRate = lobjmodel.GetProgramRedemptionRate(lstrCurrency, RedemptionCodeKeys.AIR.ToString(), lobjProgramDefinition.ProgramId);
                lobjGiftCardRequest.Currency = lstrGCCurrency;
                lobjGiftCardRequest.AuthToken = lstrAuthToken;
                lobjGiftCardRequest.GiftCardId = cardId;
                lobjGiftCardRequest.Locale = locale;
                lobjGiftCardRequest.CardType = "card";
                lobjGiftCardRequest.ServiceType = Giift.Integration.Master.Entities.ServiceType.CHARITY;

                lobjGiftCard = lobjCHelper.GetSingleGiftCard(lobjGiftCardRequest);

                if (lobjGiftCard != null)
                {
                    HttpContext.Current.Session["GiftCard"] = lobjGiftCard;
                    string lstrUnitsHtml = string.Empty;
                    for (int i = 0; i < lobjGiftCard.Units.Count; i++)
                    {
                        if (lobjGiftCard.Units[i].Type.Equals("fixed"))
                        {
                            lstrUnitsHtml += "<button type='button' class='btn btn-default btnUnits" + i + "'style='' onclick='getPoints(" + i + ")'>" + lobjGiftCard.Units[i].Value + "</button>";
                        }
                    }
                    //
                    object lobjViewDetails = new
                    {
                        divImage = "<img class='card-img-top' src='" + lobjGiftCard.ImageUrls[0] + "' alt=''>",
                        spanName = "<br />" + lobjGiftCard.Name,
                        spanDescription = "<br />" + lobjGiftCard.Description,
                        spanCurrencyname = "( " + lobjGiftCard.Units[0].Unit.ToUpper() + " )",
                        spanUnits = lstrUnitsHtml,
                        divTC = lobjGiftCard.TC,
                        spanGCname = lobjGiftCard.Name.ToUpper()
                    };
                    lstrResponse = lobjViewDetails;
                }
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("GiiftCardPurchase BindCardDetails Exception :" + ex.Message + Environment.NewLine + ex.StackTrace);
        }

        return lstrResponse;
    }

    [WebMethod]
    public static string GetTotalPoints(string unitId)
    {
        if (HttpContext.Current.Session["GiftCard"] != null)
        {
            GiftCard lobjGiftCard = (GiftCard)HttpContext.Current.Session["GiftCard"];
            return Convert.ToString(lobjGiftCard.Units[Convert.ToInt32(unitId)].TotalPoints);
        }
        else
        {
            return "";
        }
    }

    public static string RedeemPoints(float pfltAmount, int pintPoints, string pstrRelationReference, string pstrPassword, string pstrNarration, int pintLoyaltyTxnType, string pstrProgramCurrency)
    {
        string lstrMerchantId = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["MerchantId"]);
        string lstrMerchantUserName = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["MerchantUserName"]);
        string lstrMerchantPassword = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["MerchantPassword"]);

        string strRedeemMilesResponse = string.Empty;
        PGHelper lobjPGHelper = new PGHelper();
        strRedeemMilesResponse = lobjPGHelper.DoOtherRedemption(pfltAmount, pfltAmount, pintPoints, string.Empty, string.Empty, pstrRelationReference, pstrPassword, pstrNarration, Convert.ToInt32(RelationType.LBMS), pintLoyaltyTxnType, pstrProgramCurrency, lstrMerchantId, lstrMerchantUserName, lstrMerchantPassword);
        return strRedeemMilesResponse;
    }


    [WebMethod]
    public static string BuyGiftCard(string unitId)
    {
        string lstrStatus = string.Empty;
        string lstrResponse = string.Empty;
        int pintAvailablePoints = 0;
        int lintPoints = 0;

        MemberDetails lobjMemberDetails = new MemberDetails();
        ABCModel lobjmodel = new ABCModel();
        string lstrCurrency = lobjmodel.GetDefaultCurrency();
        try
        {
            lobjMemberDetails = HttpContext.Current.Session["MemberDetails"] as MemberDetails;
            if (lobjMemberDetails != null)
            {
                if (HttpContext.Current.Session["GiftCard"] != null)
                {
                    if (HttpContext.Current.Session["AuthToken"] != null)
                    {
                        GiftCard lobjGiftCard = (GiftCard)HttpContext.Current.Session["GiftCard"];

                        lintPoints = Convert.ToInt32(lobjGiftCard.Units[Convert.ToInt32(unitId)].TotalPoints);
                        MemberRelation lobjMemberRelation = new MemberRelation();
                        lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));
                        ProgramDefinition lobjProgramDefinition = lobjmodel.GetProgramMaster();
                        pintAvailablePoints = lobjmodel.CheckAvailbility(lobjMemberRelation.RelationReference, Convert.ToInt32(lobjMemberRelation.RelationType), lstrCurrency, lobjProgramDefinition.ProgramId);

                        if ((pintAvailablePoints - lintPoints) >= 0)
                        {
                            string lstrRedeemResponse = RedeemPoints(Convert.ToSingle(lobjGiftCard.Units[Convert.ToInt32(unitId)].Value), lintPoints, lobjMemberRelation.RelationReference, lobjMemberRelation.WebPassword, lobjGiftCard.Name + " GiftCard", (int)LoyaltyTxnType.GiftCard, lstrCurrency);
                            if (lstrRedeemResponse != string.Empty)
                            {
                                GiftCardPurchaseRequest lobjGiftCardPurchaseRequest = new GiftCardPurchaseRequest();
                                lobjGiftCardPurchaseRequest.Username = Convert.ToString(ConfigurationManager.AppSettings["GCUserName"]);
                                lobjGiftCardPurchaseRequest.Password = Convert.ToString(ConfigurationManager.AppSettings["GCPassword"]);
                                lobjGiftCardPurchaseRequest.AuthToken = Convert.ToString(HttpContext.Current.Session["AuthToken"]); ;
                                lobjGiftCardPurchaseRequest.Amount = lobjGiftCard.Units[Convert.ToInt32(unitId)].Value;
                                lobjGiftCardPurchaseRequest.BranchId = Convert.ToString(ConfigurationManager.AppSettings["GCUserName"]);
                                lobjGiftCardPurchaseRequest.GiftCard = lobjGiftCard;
                                lobjGiftCardPurchaseRequest.MemberId = lobjMemberRelation.RelationReference;
                                lobjGiftCardPurchaseRequest.OperatorId = lobjMemberRelation.RelationReference;
                                lobjGiftCardPurchaseRequest.PosId = "";
                                lobjGiftCardPurchaseRequest.ReceiptId = lstrRedeemResponse;
                                lobjGiftCardPurchaseRequest.State = null;
                                lobjGiftCardPurchaseRequest.CardLanguage = "EN";
                                lobjGiftCardPurchaseRequest.Qty = 1;
                                lobjGiftCardPurchaseRequest.UnitId = Convert.ToInt32(unitId);
                                lobjGiftCardPurchaseRequest.ServiceType = Giift.Integration.Master.Entities.ServiceType.CHARITY;


                                CHelper lobjCHelper = new CHelper();
                                GiftCardPurchaseResponse lobjGiftCardPurchaseResponse = lobjCHelper.PurchaseGiftCard(lobjGiftCardPurchaseRequest);

                                lstrStatus = "SUCCESS";
                            }
                            else
                            {
                                lstrStatus = "REDEEM_FAILED";
                            }
                        }
                        else
                        {
                            lstrStatus = "INSUFFICIENT_POINTS";
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            LoggingAdapter.WriteLog("GiftCardPurchase BuyGiftCard Exception: " + ex.Message + ex.InnerException + ex.StackTrace);
        }

        return lstrStatus;
    }

    private static string Encrypt(string clearText)
    {
        string EncryptionKey = Convert.ToString(ConfigurationManager.AppSettings["GCEncryptionKey"]);

        byte[] clearBytes = Encoding.Unicode.GetBytes(clearText);
        using (Aes encryptor = Aes.Create())
        {
            Rfc2898DeriveBytes pdb = new Rfc2898DeriveBytes(EncryptionKey, new byte[] { 0x49, 0x76, 0x61, 0x6e, 0x20, 0x4d, 0x65, 0x64, 0x76, 0x65, 0x64, 0x65, 0x76 });
            encryptor.Key = pdb.GetBytes(32);
            encryptor.IV = pdb.GetBytes(16);
            using (MemoryStream ms = new MemoryStream())
            {
                using (CryptoStream cs = new CryptoStream(ms, encryptor.CreateEncryptor(), CryptoStreamMode.Write))
                {
                    cs.Write(clearBytes, 0, clearBytes.Length);
                    cs.Close();
                }
                clearText = Convert.ToBase64String(ms.ToArray());
            }
        }
        return clearText;
    }
}