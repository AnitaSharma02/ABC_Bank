<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true" CodeFile="CarSearch.aspx.cs" Inherits="CarSearch" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">

    <link href="Css/jquery.ui.autocomplete.css" rel="stylesheet" type="text/css" />
    <link href="Css/jquery.ui.datepicker.css" rel="stylesheet" type="text/css" />

    <%--selectric--%>
    <link href="Css/dropDown.css" rel="stylesheet" type="text/css" />
    <script src="Jquery/jquery.selectric.min.js" type="text/javascript"></script>

    <%--for Car--%>
    <script src="Jquery/CarResultScript.js" type="text/javascript"></script>
    <script src="Jquery/CarSearchLoad.js" type="text/javascript"></script>
    <script src="Jquery/JSCarFillMethods.js" type="text/javascript"></script>
    <style>
        div#sitemap {display: none;}
    </style>
    <div class="banner">
                <img src="../images/car-banner.jpg" />
            </div>
    <div class="innerPages">
        <div class="tab_box">
	        <ul>
                <li><a class="icnFlight"  href="FlightSearch.aspx"> <p data-i18n="index-flights">Flights</p></a></li>
                <li><a class="icnHotel" href="HotelSearch.aspx"> <p data-i18n="index-hotel">Hotels</p></a></li>
                <li><a class="icnCar active" href="CarSearch.aspx" ><p data-i18n="index-book-car">Car Rental</p></a></li>
            </ul>
        </div>	
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="innerBox serviceWidget">
                        <!--Car Search Panel Start -->
                        <div id="CarValidationError" runat="server" class="Searchvalid" data-i18n="flight-below-fields"></div>
                        <div class="form_box carBlk">
                            <h3 style="text-align: center;min-height: 200px;line-height: 200px; float: none!important; font-size: 24px;" data-i18n="text-coming-soon">Coming Soon!</h3>
                            <div class="d-none">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label data-i18n="car-country-label">Country</label>
                                    <div class="select_box dropDown">
                                        <select id="DDLCountry" runat="server" class="form-control">
                                            <option selected="selected" value="Select Country" data-i18n="[value]car-country-input">Select Country</option>
                                            <option value="Austria">Austria</option>
                                            <option value="France">France</option>
                                            <option value="Greece">Greece</option>
                                            <option value="India">India</option>
                                            <option value="Qatar">Qatar</option>
                                            <option value="Russia">Russia</option>
                                            <option value="Saudi">Saudi Arabia</option>
                                            <option value="more">Load all countries...</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label data-i18n="car-city-label">City</label>
                                    <div class="select_box dropDown">
                                        <select id="DDlCity" runat="server" class="form-control">
                                            <option selected="selected" value="Select City" data-i18n="[value]car-city-input">Select City</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label data-i18n="car-location-label">Location</label>
                                    <div class="select_box dropDown">
                                        <select id="DDLLocation" runat="server" class="form-control">
                                            <option selected="selected" value="Select Location" data-i18n="[value]car-location-input">Select Location</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3 divDropContainer">
                                <div class="col-md-4">
                                    <label data-i18n="car-country-label">Country</label>
                                    <div class="select_box dropDown">
                                        <select id="ddlDropCountry" runat="server" class="form-control">
                                            <option selected="selected" value="Select Country" data-i18n="[value]car-country-input">Select Country</option>
                                            <option value="Austria">Austria</option>
                                            <option value="France">France</option>
                                            <option value="Greece">Greece</option>
                                            <option value="India">India</option>
                                            <option value="Qatar">Qatar</option>
                                            <option value="Russia">Russia</option>
                                            <option value="Saudi">Saudi Arabia</option>
                                            <option value="more">Load all countries...</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label data-i18n="car-city-label">City</label>
                                    <div class="select_box dropDown">
                                        <select id="ddlDropCity" runat="server" class="form-control">
                                            <option selected="selected" value="Select City" data-i18n="[value]car-city-input">Select City</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label data-i18n="car-location-label">Location</label>
                                    <div class="select_box dropDown">
                                        <select id="ddlDropLocation" runat="server" class="form-control">
                                            <option selected="selected" value="Select Location" data-i18n="[value]car-location-input">Select Location</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label data-i18n="car-pick-up-Date-label">Pick-Up Date</label>
                                            <div class="input-group">
                                                <input class="input datePicker form-control" value="Enter Date" onfocus="placeholderOnFocus(this, $.i18n('car-pick-up-Date-input'));"
                                                    onblur="placeholderOnFocus(this, $.i18n('car-pick-up-Date-input'));" data-i18n="[value]hotel-check-out-input" type="text" id="CarTextBoxCheckin" runat="server" readonly="readonly" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label data-i18n="car-pick-up-time-label">Pick-Up Time</label>
                                            <div class="row">
                                                <div class="col-6">
                                                    <div class="select_box selTime">
                                                        <select class="dropdown-select down-arrow form-control" id="ddlFromTime" runat="server">
                                                            <option value="0" selected="selected">00</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="select_box selTime">
                                                        <select class="form-control" id="ddlMinFrom" runat="server">
                                                            <option selected="selected" value="00">00</option>
                                                            <option value="15">15</option>
                                                            <option value="30">30</option>
                                                            <option value="45">45</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label data-i18n="car-drop-Off-date-label">Drop-Off Date</label>
                                            <div class="input-group">
                                                <input class="input datePicker form-control" value="Enter Date" onfocus="placeholderOnFocus(this, $.i18n('car-drop-Off-date-input'));"
                                                    onblur="placeholderOnFocus(this, $.i18n('car-drop-Off-date-input'));" data-i18n="[value]hotel-check-out-input" type="text" id="CarTextBoxCheckout" runat="server" readonly="readonly" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label data-i18n="car-drop-Off-time-label">Drop-Off Time</label>
                                            <div class="row">
                                                <div class="col-6">
                                                    <div class="select_box selTime">
                                                        <select class="dropdown-select down-arrow form-control" id="ddlDropFromTime" runat="server">
                                                            <option value="0" selected="selected">00</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="select_box selTime">
                                                        <select class="form-control" id="ddlDropMinFrom" runat="server">
                                                            <option selected="selected" value="00">00</option>
                                                            <option value="15">15</option>
                                                            <option value="30">30</option>
                                                            <option value="45">45</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <asp:HiddenField ID="hdnddlToTime" runat="server" />
                                                <asp:HiddenField ID="hdnddlFromTime" runat="server" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="row">
                                        <div class="col-md-12 valignM">
                                            <input id="droploction" value="1" runat="server" checked="checked" type="checkbox">
                                            <label style="vertical-align: middle;" data-i18n="car-return-label">Return to same location</label>
                                        </div>
                                        <div class="col-md-12 valignM">
                                            <input id="chkDriver" type="checkbox" value="1" runat="server" checked="checked" />
                                            <label style="vertical-align: middle;" data-i18n="car-driver-label">Driver aged between 25-70 Years?</label>
                                            <asp:TextBox ID="txtDiverAge" runat="server" Text="25" Width="10%" onfocus="placeholderOnFocus(this,'Enter Date');"
                                                onblur="placeholderOnFocus(this,'Enter Date');" Style="display: none"></asp:TextBox>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 my-3">
                                    <div class="searchBtn">
                                        <button onclick="var retvalue = LocationSearchCarSearch(); event.returnValue= retvalue;event.preventDefault(); return retvalue;" type="button" class="txt-btn-Car blue_button text-uppercase float-right" value=" Search " data-i18n="car-search-btn">Search Car</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--Car Search Panel Ends-->
                    </div>
                        </div>
                </div>
            </div>


        </div>
    </div>
</asp:Content>

