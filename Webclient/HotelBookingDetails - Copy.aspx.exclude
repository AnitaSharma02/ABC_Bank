<%@ Page Title="Hotel Booking Details" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true"
    CodeFile="HotelBookingDetails.aspx.cs" Inherits="HotelBookingDetails" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">
    <style>
        .editBtn:hover {
            color: #fff;
        }

        @media (max-width: 800px) {
            .hotelBox {
                margin: 0;
            }

            .airReview, .flightBox, .passDetails, .hotelBox {
                margin: auto !important;
            }
        }
    </style>
    <div class="breadcrumbBox mb-3 mb-lg-5">
        <div class="container">
            <div class="flightPage">
                <div class="breadcrumbFlight">
                    <ul class="d-flex">
                        <li>
                            <a href="\">
                                <img class="pr-3" src="../images/arrow-left.svg" />
                            </a>
                        </li>
                        <li><a href="\" class="custom-text">Home</a></li>
                        <li class="px-2">/</li>
                        <li><a href="HotelSearch.aspx">Hotel Search</a></li>
                        <li class="px-2">/</li>
                        <li class="brd-bold fontBold">Hotel Booking Details</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="hotelBox">
        <div class="container passDetails ">
            <div class="row">
                <div class="col-md-12">
                    <div id="divError" class="ErrorMsgContainer text-capitalise" runat="server">
                        <asp:Label ID="lblError" CssClass="errorMsg" runat="server"></asp:Label>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="checkoutheader">
                        <div class="p-0">
                            <h1 class="txt-personal-detail" data-i18n="hotel-booking-personal">Personal Details</h1>
                            <div class="passenger-block">
                                <div class="row mb-2">
                                    <div style="display: none">
                                        <asp:TextBox ID="txtState" runat="server" CssClass="textBoxHotelBooking" Style="height: 1.7vw; width: 52%"></asp:TextBox>
                                        <asp:TextBox ID="txtPhoneNo" runat="server" CssClass="textbox TxtBox_Width85"></asp:TextBox>
                                    </div>
                                    <div class="col-md-4 col-6 mb-1">
                                        <label class="txt-Title" data-i18n="hotel-booking-title">Title*</label>
                                        <div class="select_box">
                                            <asp:DropDownList ID="ddlPersonalTitle" runat="server" CssClass="form-control">
                                                <asp:ListItem Text="Mr." Value="0"></asp:ListItem>
                                                <asp:ListItem Text="Ms." Value="1"></asp:ListItem>
                                                <asp:ListItem Text="Mrs." Value="2"></asp:ListItem>
                                            </asp:DropDownList>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2">
                                        <label class="txt-first-name" data-i18n="hotel-booking-fname">First Name*</label>
                                        <asp:TextBox ID="txtFirstName" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtFirstName" Style="padding: 0; margin: 0; vertical-align: top;"
                                            CssClass="detailsfield error_msg width100" ID="RequiredFieldValidator1"
                                            runat="server" ErrorMessage="Enter First Name" data-i18n="hotel-booking-errorfname" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:CustomValidator runat="server" ID="cusCustom" CssClass="detailsfield error_msg width100"
                                            ControlToValidate="txtFirstName" OnServerValidate="custom_NameValidate" ErrorMessage="Enter only alpha" data-i18n="hotel-booking-erroralpha" />
                                        <asp:RegularExpressionValidator ID="revAdultFirstName" Display="Dynamic" runat="server"
                                            ControlToValidate="txtFirstName" ValidationGroup="WebValidation" ValidationExpression="^[a-zA-Z'.\s]{1,50}"
                                            CssClass="rptErrorMassage entervalidfname" ErrorMessage="Please Enter valid First Name." data-i18n="hotel-booking-errorvalidfname"></asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2">
                                        <label class="txt-last-name" data-i18n="hotel-booking-lname">Last Name*</label>
                                        <asp:TextBox ID="txtLastname" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtLastname" CssClass="error_msg width100"
                                            ID="RequiredFieldValidator2" runat="server" ErrorMessage="Enter Last Name" data-i18n="hotel-booking-errorlname" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:CustomValidator runat="server" ID="CustomValidatorLastName" CssClass="detailsfield error_msg width100"
                                            ControlToValidate="txtLastname" OnServerValidate="custom_NameValidate" ErrorMessage="Enter only alpha" data-i18n="hotel-booking-erroralpha" />
                                        <asp:RegularExpressionValidator ID="revtxtLastname" Display="Dynamic" runat="server"
                                            ControlToValidate="txtLastname" ValidationGroup="WebValidation" ValidationExpression="^[a-zA-Z'.\s]{1,50}"
                                            CssClass="rptErrorMassage entervalidfname" ErrorMessage="Please Enter valid Last Name." data-i18n="hotel-booking-errorvalidlname"></asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2">
                                        <label class="txt-h-city" data-i18n="hotel-booking-city">City*</label>
                                        <asp:TextBox ID="txtCity" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtCity" CssClass="error_msg width100"
                                            ID="RequiredFieldValidator4" runat="server" ErrorMessage="Enter City" data-i18n="hotel-booking-errorcity" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:RegularExpressionValidator ID="revtxtCity" Display="Dynamic" runat="server"
                                            ControlToValidate="txtCity" ValidationGroup="WebValidation" ValidationExpression="^[a-zA-Z'.\s]{1,50}"
                                            CssClass="rptErrorMassage entervalidfname" ErrorMessage="Please Enter valid City." data-i18n="hotel-booking-errorvalidfname"></asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2">
                                        <label class="txt-c-country" data-i18n="hotel-booking-country">Country*</label>
                                        <asp:TextBox ID="txtCountry" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtCountry" CssClass="error_msg width100"
                                            ID="RequiredFieldValidator5" runat="server" ErrorMessage="Enter Country" data-i18n="hotel-booking-errorcountry" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:RegularExpressionValidator ID="revtxtCountry" Display="Dynamic" runat="server"
                                            ControlToValidate="txtCountry" ValidationGroup="WebValidation" ValidationExpression="^[a-zA-Z'.\s]{1,50}"
                                            CssClass="rptErrorMassage entervalidfname" ErrorMessage="Please Enter valid Country." data-i18n="hotel-booking-errorvalidfname"></asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2 d-none">
                                        <label data-i18n="hotel-booking-state">State</label>
                                        <asp:TextBox ID="TextBox1" runat="server" CssClass="form-control"></asp:TextBox>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2 d-none">
                                        <label data-i18n="hotel-booking-phone">Phone Number</label>
                                        <asp:TextBox ID="TextBox2" runat="server" CssClass="form-control"></asp:TextBox>
                                    </div>
                                    <div class="col-md-4 col-6  mb-2">
                                        <label class="txt-postal-code" data-i18n="hotel-booking-postal">Postal Code*</label>
                                        <asp:TextBox ID="txtPostalCode" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtPostalCode" CssClass="error_msg width100"
                                            ID="RequiredFieldValidator6" runat="server" ErrorMessage="Enter Postal Code" data-i18n="hotel-booking-errorpostal"
                                            Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:RegularExpressionValidator ID="RegularExpressionValidator2" runat="server" ErrorMessage="Enter Only Digits" data-i18n="hotel-booking-erroronlydigit"
                                            ControlToValidate="txtPostalCode" CssClass="error_msg width100" ValidationExpression="^[0-9]+$">
                                        </asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-6 col-12  mb-2">
                                        <label class="txt-mobile" data-i18n="hotel-booking-mobile">Mobile No (without country code)*</label>
                                        <asp:TextBox ID="txtMobileNo" runat="server" CssClass="form-control"> </asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtMobileNo" CssClass="error_msg width100"
                                            ID="RequiredFieldValidator7" runat="server" ErrorMessage="Enter Mobile No" data-i18n="hotel-booking-errormobile" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:RegularExpressionValidator ID="RegularExpressionValidator1" runat="server" ErrorMessage="Enter Only Digits" data-i18n="hotel-booking-erroronlydigit"
                                            ControlToValidate="txtMobileNo" CssClass="error_msg width100" ValidationExpression="^[0-9]+$"> </asp:RegularExpressionValidator>
                                    </div>

                                    <div class="col-md-6 col-12  mb-2">
                                        <label class="txt-email" data-i18n="hotel-booking-email">E-Mail Address*</label>
                                        <asp:TextBox ID="txtEmailID" runat="server" CssClass="form-control"></asp:TextBox>
                                        <asp:RequiredFieldValidator ControlToValidate="txtEmailID" ID="RequiredFieldValidator9"
                                            CssClass="error_msg width100" runat="server" ErrorMessage="Enter Email" data-i18n="hotel-booking-erroremail" Display="Dynamic"></asp:RequiredFieldValidator>
                                        <asp:RegularExpressionValidator ID="RegularExpressionValidator4" runat="server" ErrorMessage="Email Address not valid" data-i18n="hotel-booking-errorvalidemail"
                                            CssClass="error_msg width100" ControlToValidate="txtEmailID" ValidationExpression="^[a-zA-Z][\w\.-]*[a-zA-Z0-9]@[a-zA-Z0-9][\w\.-]*[a-zA-Z0-9]\.[a-zA-Z][a-zA-Z\.]*[a-zA-Z]$"></asp:RegularExpressionValidator>
                                    </div>
                                    <div class="col-md-12 col-12 mb-2">
                                        <label class="txt-special-request" data-i18n="hotel-booking-special">Special Request</label>
                                        <asp:TextBox ID="txtSpecialRequest" runat="server" TextMode="MultiLine" CssClass="form-control"></asp:TextBox>
                                    </div>
                                </div>
                                <div class="hTerms">
                                    <p>
                                        <label>
                                            <asp:CheckBox ID="chkAcceptAgreements" runat="server" />
                                            <span data-i18n="hotel-booking-ihave">I have read and agree to NIC Asia </span><a href="TermsandConditions.aspx" target="_blank"><span data-i18n="hotel-booking-terms">Terms
                                                & Conditions</span></a> <span data-i18n="hotel-booking-andthe">and the </span><a href="BookingPolicy.aspx" target="_blank"><span data-i18n="hotel-booking-bookingcancel">Booking & Cancellation Policy</span></a>
                                            <span data-i18n="hotel-booking-ofthe-resp">of the respective service provider.</span></label>
                                    </p>
                                    <p>
                                        <label>
                                            <asp:CheckBox ID="chkCancellationPolicy" runat="server" />
                                            <span data-i18n="hotel-booking-iagree">I agree to redeem</span>
                                            <asp:Label ID="lblTotalCharge" runat="server" Text=""></asp:Label>. <span data-i18n="hotel-booking-ialso">I also understand and accept that the redeemed points cannot be refunded or credited upon cancellation of a hotel booking.</span></label>
                                    </p>
                                </div>
                                <div class="text-right searchBtn" id="Bookbtn" runat="server">
                                    <label class="btn btn-yellow">
                                        <asp:Button ID="btnBook" runat="server" OnClientClick="return onAcceptArgument();" OnClick="btnBook_Click" class="" Text="BOOK NOW" data-i18n="[value]hotel-book-now"></asp:Button>
                                    </label>
                                </div>
                                <div class="col-md-12">
                                    <div id="ErrorMsgContainer" class="ErrorMsgContainer  mB10p disnone red" style="color: #ff0000; margin-left: 0px;" runat="server">
                                        <div id="LoginValidation"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="orderSum">
                        <div class="p-0">
                            <div class="txt-itinerary">
                                <h3 class="d-inline txt-hotel-detail" data-i18n="hotel-booking-hoteldetails">Hotel Details</h3>
                                <a href="HotelResults.aspx?edit=1" class="d-inline float-right editBtn" data-i18n="hotel-booking-edit">Edit</a>
                            </div>

                            <div class="shopping-list">
                                <ul>
                                    <li class="total">
                                        <div>
                                            <asp:Label runat="server" class="Hotelname" ID="lblHotelName"></asp:Label>
                                            <asp:Label class="loca" ID="lblAddress" runat="server"></asp:Label>
                                        </div>
                                    </li>
                                    <li class="hot-detail">
                                        <div class="row">
                                            <div class="col-md-3 col-3">
                                                <asp:Image ID="imgHotel" runat="server" />
                                            </div>
                                            <div class="col-md-3 col-3">
                                                <p data-i18n="hotel-booking-checkin">
                                                    Check-in
                                                </p>
                                                <div class="item-Name">
                                                    <asp:Label runat="server" ID="lblCheckinDate" Style="text-transform: uppercase"></asp:Label>
                                                </div>
                                                <div class="clear">
                                                </div>
                                            </div>
                                            <div class="col-md-3 col-3 roomNight">
                                                <img src="images/time.png" />
                                                <p>
                                                    <asp:Label ID="lblNoofNights" runat="server"></asp:Label>
                                                    <br />
                                                    <asp:Label runat="server" ID="lblNoOfAdult"></asp:Label>
                                                </p>
                                            </div>
                                            <div class="col-md-3 col-3">
                                                <p data-i18n="hotel-booking-checkout">
                                                    Check-out
                                                </p>
                                                <div class="item-Name">
                                                    <asp:Label runat="server" ID="lblCheckoutDate" Style="text-transform: uppercase"></asp:Label>
                                                </div>
                                                <div class="clear">
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-footer">
                                <span data-i18n="hotel-booking-totalpoints">Total Points:</span> <span class="point">
                                    <asp:Label runat="server" ID="lblTotalMiles" CssClass="gray"></asp:Label></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript" language="javascript">
        function onAcceptArgument() {
            var msg = "";
            $("#CP_ErrorMsgContainer").hide();
            if (($("#CP_chkAcceptAgreements").prop("checked") == true) && ($("#CP_chkCancellationPolicy").prop("checked") == true)) {
                return true;
            }
            if ($("#CP_chkCancellationPolicy").prop("checked") == false) {
                msg += "Accept cancellation policy<br/>";
            }
            if ($("#CP_chkAcceptAgreements").prop("checked") == false) {
                msg += "Accept Terms And Conditions<br/>";
            }
            if (msg.length > 0) {
                $("#LoginValidation")[0].innerHTML = msg;
                $("#CP_ErrorMsgContainer").show();
                return false;
            }
            e.preventDefault();
        }
    </script>
</asp:Content>
