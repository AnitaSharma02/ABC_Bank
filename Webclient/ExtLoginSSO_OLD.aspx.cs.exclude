                                    }
                                    else
                                    {
                                        sb.Append(Convert.ToString(DataList[i]) + "|");
                                    }
                                }

                                LoggingAdapter.WriteLog("ExtLoginSSO Md5EncyrptHashReq = " + sb.ToString());

                                string Md5EncyrptHash = EncryptStringMD5(sb.ToString());

                                LoggingAdapter.WriteLog("ExtLoginSSO Md5EncyrptHashRes = " + Md5EncyrptHash);

                                bool validateMerchant = false;
                                string ExtLoginSSOMerchantId = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["ExtLoginSSOMerchantId"]);
                                string ExtLoginSSOMerchantPassword = Convert.ToString(System.Configuration.ConfigurationManager.AppSettings["ExtLoginSSOMerchantPassword"]);

                                if (Md5EncyrptHash == DataList[8].ToString())
