using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using ABC.Model;
using Core.Platform.ProgramMaster.Entities;
using System.Text.RegularExpressions;
using Core.Platform.MemberActivity.Constants;
using Core.Platform.MemberActivity.Entities;
using Core.Platform.Member.Entites;

public partial class ResetPassword : System.Web.UI.Page
{
    protected void Page_Load(object sender, EventArgs e)
    {
        if (!Page.IsPostBack)
        {
            string lstrHashkeystr = Convert.ToString(Request.QueryString["Key"]);
            if (lstrHashkeystr == null || lstrHashkeystr.Trim() == string.Empty)
            {
                //Response to page expired or warning page.. 
                Response.Redirect("Warningpage.aspx");
            }
            List<SecurityDetails> lobjSecurityDetailslist = null;
            SecurityDetails lobjSecurityDetails = new SecurityDetails();
            ABCModel lobjModel = new ABCModel();
            Framework.EnterpriseLibrary.PasswordReset.Entities.ResetPassword lobjResetPassword = new Framework.EnterpriseLibrary.PasswordReset.Entities.ResetPassword();
            lobjResetPassword.HashKey = lstrHashkeystr;
            lobjResetPassword = lobjModel.GetDetailsFromHashKey(lobjResetPassword);
            if (lobjResetPassword == null)
                Response.Redirect("Warningpage.aspx"); //  ie not a valid key..

            bool lblnIsPwdValidated = lobjModel.ValidateResetToken(lobjResetPassword);
            if (!lblnIsPwdValidated)
            {
                Response.Redirect("Warningpage.aspx");
            }
            else
            {
                MemberDetails lobjMemberDetails = lobjModel.GetMemberDetails(lobjResetPassword.UniqueIdentifier);
                ProgramDefinition lobjProgramDefinition = null;
                lobjProgramDefinition = lobjModel.GetProgramMaster();

                lobjSecurityDetails.RelationReference = lobjMemberDetails.MemberRelationsList.Find(x => x.RelationType.Equals(RelationType.LBMS)).RelationReference;
                lobjSecurityDetails.ProgramId = lobjProgramDefinition.ProgramId;
                lobjSecurityDetailslist = lobjModel.GetMemberSecurityDetails(lobjSecurityDetails);

                if (lobjSecurityDetailslist != null && lobjSecurityDetailslist.Count > 0)
                {
                    Session["MemberSecurityDetails"] = lobjSecurityDetailslist;

                    ddlSecurityQuestion1.DataSource = lobjSecurityDetailslist;
                    ddlSecurityQuestion1.DataTextField = "SecurityQuestion";
                    ddlSecurityQuestion1.DataValueField = "Id";
                    ddlSecurityQuestion1.DataBind();
                }

                hfSecurityQuestion1.Value = lobjSecurityDetailslist[0].SecurityQuestion;

                hdnId.Value = lobjMemberDetails.MemberRelationsList.Find(x => x.RelationType.Equals(RelationType.LBMS)).RelationReference;
                Session["ResetPWD"] = lobjResetPassword;
            }
        }
    }

    [System.Web.Script.Services.ScriptMethod()]
    [System.Web.Services.WebMethod]
    public static string ResetPasswordForMembers(string pstrNewPassword, string pstrSecuritycode, string pstrSecurityQuestion, string pstrSecurityAnswer)
    {
        ABCModel lobjModel = new ABCModel();
        string mstrRedirectEmptyURL = string.Empty;
        Framework.EnterpriseLibrary.PasswordReset.Entities.ResetPassword lobjResetPassword = HttpContext.Current.Session["ResetPWD"] as Framework.EnterpriseLibrary.PasswordReset.Entities.ResetPassword;
        MemberDetails lobjMemberDetails = new MemberDetails();
        lobjMemberDetails = lobjModel.GetMemberDetails(lobjResetPassword.UniqueIdentifier);
        List<SecurityDetails> lobjSecurityDetailslist = HttpContext.Current.Session["MemberSecurityDetails"] as List<SecurityDetails>;
        SecurityDetails lobjSecurityDetails = new SecurityDetails();
        if (lobjMemberDetails != null)
        {
            if (HttpContext.Current.Session["CAPTCHA"].ToString().Equals(pstrSecuritycode))
            {
                lobjSecurityDetailslist = lobjSecurityDetailslist.FindAll(x => x.SecurityQuestion.Equals(pstrSecurityQuestion));
                if (lobjSecurityDetailslist[0].SecurityAnswer.ToLower() == pstrSecurityAnswer.ToLower())
                {
                    MemberRelation lobjMemberRelation = new MemberRelation();
                    lobjMemberRelation = lobjMemberDetails.MemberRelationsList.Find(lobj => lobj.RelationType.Equals(RelationType.LBMS));
                    lobjMemberRelation.WebPassword = pstrNewPassword.ToUpper(); //Hashed
                    lobjResetPassword.ResetDatetime = DateTime.Today;
                    lobjResetPassword.ResetIpAddress = HttpContext.Current.Request.UserHostAddress;
                    bool blnIsUpdated = lobjModel.UpdatePassword(lobjResetPassword, lobjMemberRelation);
                    HttpContext.Current.Session["ResetPWD"] = string.Empty;
                    if (blnIsUpdated)
                    {
                        mstrRedirectEmptyURL = "Success";
                    }
                    else
                    {
                        mstrRedirectEmptyURL = "failure";
                    }
                }
                else
                {
                    mstrRedirectEmptyURL = "Invalid_SecurityAnswer";
                }
            }
            else
            {
                mstrRedirectEmptyURL = "Invalid_SecurityCode";
            }
        }

        lobjModel.LogActivity(string.Format(ActivityConstants.ResetMemberPassword, lobjResetPassword.UniqueIdentifier) + "Status-" + mstrRedirectEmptyURL, ActivityType.ResetPassword);
        return mstrRedirectEmptyURL;
    }

    protected void lnkBtnRefresh_Click(object sender, EventArgs e)
    {
        ImgCaptcha.ImageUrl = string.Format("~/captcha.ashx?refresh={0}", Guid.NewGuid());
    }
}