<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true"
    CodeFile="CarDetails.aspx.cs" Inherits="CarDetails" %>

    <asp:Content ID="Content2" ContentPlaceHolderID="CP" runat="Server">
        <link href="Css/Car.css" type="text/css" rel="stylesheet" />
        <!--Page Content Starts-->
        <div class="innerPages">
            <div class="container">
                <h2 data-i18n="car-booking-details">Booking Details</h2>
            </div>
            <div class="container passDetails">
                <div class="row">
                    <div class="col-md-7">
                        <div class="innerBox">
                            <!--CheckOut Page Starts-->
                            <asp:HiddenField Value="" ID="hdnPaymentType" runat="server"></asp:HiddenField>
                            <div class="checkoutheader">
                                <h1 data-i18n="car-details-excess">Excess Protection</h1>
                                <div class="car-detail">
                                    <div style="font-weight: bold;">
                                        <asp:Label ID="Label1" runat="server" data-i18n="car-details-damage-excess" Text="Damage Excess Refund "></asp:Label>
                                        <asp:Label ID="lblHDDERAmount" Visible="false" runat="server" Text="Amount: "></asp:Label>
                                        <asp:Label ID="lblDERAmount" Visible="false" runat="server" Text=""></asp:Label>
                                        <asp:Label ID="lblHDDERPoint" runat="server" Text="Points:" data-i18n="car-details-points" ></asp:Label>
                                        <asp:Label ID="lblDERPoint" runat="server" Text=""></asp:Label>
                                    </div>
                                    <div>
                                        <span data-i18n="car-details-excess-protection">Excess Protection - Excellent Value, Best Cover, Peace of Mind</span>
                                <div class="fL width100" data-i18n="car-details-when-you">
                                    When you pick up your car a deposit is usually held on your card for your excess
                                    which may be charged if the vehicle is damaged. Take our Damage Excess Refund and
                                    if you have any bumps or scrapes we'll refund any deductions from your excess.
                                </div>
                                        <div style="padding: 20px; float: left; font-size: 12px;">
                                            <ul style="list-style-type: disc;">
                                                <li style="list-style-type: disc; padding-bottom: 5px;" data-i18n="car-details-you-are">You're protected - Damage Excess Refund protects you when things go wrong and you
                                            are required to pay out from your excess.</li>
                                                <li style="list-style-type: disc; padding-bottom: 5px;" data-i18n="car-details-accidents">Accidents covered - Your excess will be protected if your vehicle is damaged in
                                            an accident.</li>
                                                <li style="list-style-type: disc; padding-bottom: 5px;" data-i18n="car-details-damage-cover">Damage cover - Damage to bodywork, vehicle parts and accessories incurred during
                                            most driving incidents is covered.</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="clr">
                                    </div>
                                    <button class="blue_button" onclick="var retValue=CarDetailsBookNow(false); event.returnValue = retValue;event.preventDefault();return retValue;" data-i18n="car-details-no-continue">
                                        No, Continue</button>
                                    <button class="blue_button" onclick="var retValue=CarDetailsBookNow(true); event.returnValue = retValue;event.preventDefault();return retValue;" data-i18n="car-details-yes-iwill">
                                        Yes i'll take it</button>
                                    <div class="clr">
                                    </div>
                                </div>
                            </div>
                            <!--StepsPage-->
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="innerBox ">
                            <div class="orderSum carBlk">
                                <div class="editbox">
                                    <h3 data-i18n="car-details-itinerary">Itinerary</h3>
                                    <span class="edit"><a href="CarList.aspx?edit=1" data-i18n="car-details-edit">Edit</a> </span>
                                </div>
                                <div class="shopping-list">
                                    <ul>
                                        <li>
                                            <div class="amt">
                                                <asp:Label runat="server" ID="lblCarName"></asp:Label>
                                            </div>
                                            <div class="clear">
                                            </div>
                                        </li>
                                        <li>
                                            <div class="txtC">
                                                <asp:Image runat="server" ID="imgCar" />
                                            </div>
                                        </li>
                                        <li>
                                            <div class="itenaryContent">
                                                <div class="item-Name">
                                                    <asp:Label runat="server" ID="lblPickLocation"></asp:Label>
                                                    <asp:Label runat="server" ID="lblPickCountry"></asp:Label>
                                                </div>
                                                <p>
                                                    <asp:Label runat="server" ID="lblPickDateTime"></asp:Label>
                                                </p>
                                                <p>
                                                    <asp:Label runat="server" ID="lblPickTime"></asp:Label>
                                                </p>
                                            </div>
                                            <div class="itenaryContent">
                                                <div class="item-Name">
                                                    <asp:Label runat="server" ID="lblDropLocation"></asp:Label>
                                                    <asp:Label runat="server" ID="lblDropCountry"></asp:Label>
                                                </div>
                                                <p>
                                                    <asp:Label runat="server" ID="lblDropDateTime"></asp:Label>
                                                </p>
                                                <p>
                                                    <asp:Label runat="server" ID="lblDropTime"></asp:Label>
                                                </p>
                                            </div>
                                            <div class="clear">
                                            </div>
                                        </li>
                                        <li class="total">
                                            <div class="total-re ">
                                                <span class="amt">
                                                    <asp:Label runat="server" ID="Title_Total"></asp:Label>
                                                    <asp:Label runat="server" ID="Total_Value"></asp:Label>
                                                </span>
                                                <div class="clr">
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Page Content Starts-->
        <script type="text/javascript">
            function CarDetailsBookNow(isReturn) {
                $.ajax({
                    url: 'CarDetails.aspx/GetIsDERAdded',
                    type: 'POST',  // or get
                    contentType: 'application/json; charset =utf-8',
                    data: "{'IsDERAdded':'" + isReturn + "'}",
                    dataType: 'json',
                    success: function (data) {
                        if (data.d == true) {
                            window.location.href = "DriverDetails.aspx";
                        }
                        else {
                            return false;
                        }
                    }
                });
            }
        </script>
    </asp:Content>
