<%@ Page Language="C#" AutoEventWireup="true" CodeFile="ResetPassword.aspx.cs" Inherits="ResetPassword" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta name="viewport" content="width=device-width"/>
    <title>Reset Password</title>
    <link rel="stylesheet" type="text/css" href="Css/bootstrap.rtl.min.css"/>
     <script src="\Jquery/bootstrap.min.js" type="text/javascript"></script>
    <link href="Css/main.css" rel="stylesheet" type="text/css" />
    <link href="Css/responsive.css" rel="stylesheet" />
    <link href="Css/MyAccount.css" rel="stylesheet" type="text/css" />
    <script src="Jquery/jquery.min.js" type="text/javascript"></script>
    <script src="Jquery/Validation.js" type="text/javascript"></script>
    
   
    <script type="text/javascript">

        //$(document).ready(function () {
            
        //    var lstrSecurityQuestion1Val = $("#CP_ddlSecurityQuestion1 option:selected").text();
        //    $("#CP_hfSecurityQuestion1").val(lstrSecurityQuestion1Val);

        //    alert(lstrSecurityQuestion1Val);
        //})

        function ResetPassword() {
            var msg = "";

            if ($('#txtNewPassword').val() == '') {
                $('#lblForgotPasswordError')[0].innerHTML = "Please provide new password." + "<br/>";
            }
            else if ($('#txtConfirmPassword').val() == '') {
                $('#lblForgotPasswordError')[0].innerHTML = "Please provide confirm password." + "<br/>";
            }
            else if (!CheckPasswordPolicy($('#txtNewPassword').val())) {
                $('#lblForgotPasswordError')[0].innerHTML = "Password must contain one numeric digit,one upper case character,one lower case character,one special character (!@#$%*()?)." + "<br/>";
            }
            else if ($('#SecurityAnswer1').val() == '') {
                $('#lblForgotPasswordError')[0].innerHTML = "Please provide security answer." + "<br/>";
            }
            else if ($('#txtSecurityCode').val() == '') {
                $('#lblForgotPasswordError')[0].innerHTML = "Please provide security code." + "<br/>";
            }

            else if ($('#txtNewPassword').val() == $('#txtConfirmPassword').val()) {
                jQuery("#overlay").css('display', 'block');
                jQuery("#popup").css('display', 'block');
                jQuery("#popup").fadeIn(500);

                var NewPassword = $("#txtNewPassword").val();
                var Salt = $("#hdnId").val();
                var NewPwd = $.md5(Salt + NewPassword);

                var Securitycode = $("#txtSecurityCode").val();
                var SecurityQuestion = $("#ddlSecurityQuestion1 option:selected").text();
                var SecurityAnswer = $("#SecurityAnswer1").val();

                $.ajax({
                    url: 'ResetPassword.aspx/ResetPasswordForMembers',
                    type: 'POST',  // or get
                    contentType: 'application/json; charset =utf-8',
                   // data: "{'pstrNewPassword':'" + NewPwd.toString() + "'}",
                    data: "{'pstrNewPassword':'" + NewPwd.toString() + "'" + "," + "'pstrSecuritycode':'" + Securitycode.toString() + "'" + "," + "'pstrSecurityQuestion':'" + SecurityQuestion + "'," + "'pstrSecurityAnswer':'" + SecurityAnswer + "'}",
                    dataType: 'json',
                    success: function (data) {
                        try {
                            var newData = data.d;
                            if ((newData != "") || newData == null) {

                                if (data.d == "Success") {
                                    $('#lblPasswordResetSuccess')[0].innerHTML = "Reset password successfully, <a class='ErrorMessageLink' href='Login.aspx'>click here</a> to Login." + "<br/>";
                                    //FormLinkGoToLogin                        
                                    $('#txtNewPassword')[0].value = "";
                                    $('#txtConfirmPassword')[0].value = "";
                                    $('#lblForgotPasswordError').hide();
                                    $('#divResetPassword').hide();
                                    $('#PasswordPolicy').hide();
                                    $('#Header3').hide();
                                   
                                }
                                else if (data.d == "PasswordError") {
                                    $('#lblForgotPasswordError')[0].innerHTML = "Password must contain one non-alpha character,one upper case character,one lower case character." + "<br/>";
                                }
                                else if (data.d == "failure") {
                                    $('#lblForgotPasswordError')[0].innerHTML = "Reset password not successful" + "<br/>";
                                }
                                else if (data.d == "Invalid_SecurityCode") {
                                    $('#lblForgotPasswordError')[0].innerHTML = "Invalid security code" + "<br/>";
                                }
                                else if (data.d == "Invalid_SecurityAnswer") {
                                    $('#lblForgotPasswordError')[0].innerHTML = "Invalid security answer" + "<br/>";
                                }
                            }
                            jQuery("#overlay").css('display', 'none');
                            jQuery("#popup").css('display', 'none');

                        }
                        catch (e) {
                            jQuery("#overlay").css('display', 'none');
                            jQuery("#popup").css('display', 'none');
                            return false;
                        }
                    }
                });
            }
            else {
                $('#lblForgotPasswordError')[0].innerHTML = "New and confirm passwords should match." + "<br/>";
                jQuery("#overlay").css('display', 'none');
                jQuery("#popup").css('display', 'none');
            }
            return false;
        };

    </script>
    <script src="Jquery/jquery.md5.js" type="text/javascript"></script>
    <style type="text/css">
        .loginBx ul {
            list-style: none;
            margin-top: 10px;
        }
        .ErrorMsgContainer {
        font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
        }
         .ErrorMsgContainer a {
        font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 20px;
        }
    </style>
</head>
<body>


    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager" runat="server" />
       

        <div class="topHead toplinks">
            <div class="container">
                <div class="header-alignment">
                    <div>
                        <div class="navbar-brand logo">
                            <a href="Index.aspx"><img src="images/bk-logo.svg">
                                <img class="px-2 px-md-4" src="images/name.svg">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="breadcrumbBox mt-100 container" dir="ltr" style="direction: ltr;">
            <div class="row">
                <div class="col-lg-12">
                    <div class="flightPage bg-grey">
                        <h1>Reset Password</h1>
                    </div>
                </div>
            </div>
        </div>
        
        <section class="statcpgCont">
            <div class="container">
                <div class="col-12">
                    <div id="Header3" class="my-3">
                        <h3>Please create a new permanant password of your choice (according to the rules) to
                        access your account in future.</h3>
                    </div>
                    <div class="terms-condi" id="PasswordPolicy">
                        <h2>Your Password should be :</h2>
                        <br />
                        <ul class="resetli ml-5">
                            <li>Minimum 8 characters in length</li>
                            <li>Should contain at least one upper case character</li>
                            <li>Should contain at least one lower case character</li>
                            <li>Should contain at least one special character (!@#$%*()?)</li>
                            <li>Should contain at least one numeric character (1234567890)</li>
                        </ul>
                    </div>
                </div>
            </div>  
        </section>

        <div class="myAccount pt-0" id="divResetPassword">
            <div class="container my-5">
                <div class="loginBx">
                    <div class="innerBox">
                        <div >
                            <div class="w100P" style="margin: 0 0 2% 0">
                                <asp:Label runat="server" ID="lblForgotPasswordError" Style="color: #ff0000" Text="" CssClass=""></asp:Label>
                                <div id="ForgotPasswordValidation" style="color: #ff0000">
                                </div>
                            </div>
                            <asp:HiddenField ID="hdnId" runat="server" />
                            <ul>
                                <li class="label">New Password :</li>
                                <li class="input">
                                    <asp:TextBox ID="txtNewPassword" autocomplete="off" runat="server" MaxLength="12" CssClass="form-control"
                                        TextMode="Password" onkeypress="var retValue = ResetPwdOnEnter(event); event.returnValue = retValue; return retValue;"></asp:TextBox></li>
                                
                                <li class="label">Confirm Password :</li>
                                <li class="input">
                                    <asp:TextBox ID="txtConfirmPassword" autocomplete="off" runat="server" MaxLength="12" CssClass="form-control"
                                        TextMode="Password" onkeypress="var retValue = ResetPwdOnEnter(event); event.returnValue = retValue; return retValue;"></asp:TextBox></li>
                               

                                <li class="label">1st Security Question :</li>
                                <li class="input">
                                    <asp:DropDownList ID="ddlSecurityQuestion1" runat="server" CssClass="form-control">
                                    </asp:DropDownList>
                                    <asp:HiddenField ID="hfSecurityQuestion1" runat="server" />
                                </li>
                                <li class="label">Answer :</li>
                                <li class="input">
                                    <input type="text"  class="form-control" id="SecurityAnswer1" /></li>      

                                <li class="input">
                                    <asp:UpdatePanel ID="UpdatePanel1" UpdateMode="Conditional" runat="server" ChildrenAsTriggers="false">
                                        <ContentTemplate>
                                            <asp:Image ID="ImgCaptcha" runat="server" ImageUrl="~/captcha.ashx" CssClass="float-left" />
                                            <asp:LinkButton ID="lnkBtnRefresh" runat="server" OnClick="lnkBtnRefresh_Click" CssClass="float-left py-2 ml-2 text-small text-gray">Refresh</asp:LinkButton>
                                        </ContentTemplate>
                                        <Triggers>
                                            <asp:AsyncPostBackTrigger ControlID="lnkBtnRefresh" />
                                        </Triggers>
                                    </asp:UpdatePanel>
                                </li>
                                <li class="clear diNICk mb-0">&nbsp;</li>
                                <li class="label" data-i18n="text-Security-Code">Security Code:</li>
                                <li class="input">
                                    <asp:TextBox ID="txtSecurityCode" autocomplete="off" runat="server" CssClass="form-control"></asp:TextBox></li>


                                <li class="input">
                                    <asp:Button ID="ImageButton1" CssClass="blue_button w-100 mt-3" runat="server" OnClientClick="var retValue = ResetPassword(); event.returnValue = retValue;if(event.preventDefault)event.preventDefault(); return retValue;"
                                        Text="Continue" />
                                </li>
                            </ul>


                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ErrorMsgContainer Txt_Black Width95 mbot10 py-5 text-capitalise text-center">
            <asp:Label runat="server" ID="lblPasswordResetSuccess" Text="" CssClass="ErrorMsgContainer"></asp:Label>
        </div>
    </form>
</body>
</html>
