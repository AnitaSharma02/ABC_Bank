<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true"
    CodeFile="DriverDetails.aspx.cs" Inherits="DriverDetails" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">
    <link href="Css/Car.css" type="text/css" rel="stylesheet" />
    <style>
        .rptErrorMassage {
            color: #ff0000;
            font-size: 12px;
        }

        .bgcolGrL {
            background-color: #666;
            color: #fff !important;
            font-weight: 500 !important;
            /*height: 18px;*/
        }
    </style>
    <div class="innerPages">
        <div class="container">
            <h2 data-i18n="car-driver-details">Driver Details</h2>
        </div>
        <div class="container passDetails">
            <div class="row">
                <div class="col-md-7">
                    <div class="innerBox">
						<ul>
                    <li id="PointsInfo" runat="server" style="display: none">
                        <div id="Div1" runat="server">
                            <asp:Label ID="lblMsg" runat="server" Text="" Style="margin-left: 0px!important; color: #ff0000"></asp:Label>
                        </div>
                    </li>
                </ul>
                        <div class="checkoutheader">
                            <h1 data-i18n="car-driver-details">Driver Details</h1>
                            <div class="passenger-block">
                                <div id="ErrorMsgContainer" class="errorMsg"></div>
                                <div class="row">
                                    <div class="title col-md-2">
                                        <label data-i18n="hotel-booking-title">
                                            Title<span class="redcol">*</span></label>
                                        <div class="input-bg">
                                            <asp:DropDownList ID="DDLTitle" CssClass="CarSearchText alignleft" runat="server">
                                                <asp:ListItem>Mr.</asp:ListItem>
                                                <asp:ListItem>Mrs.</asp:ListItem>
                                                <asp:ListItem>Dr.</asp:ListItem>
                                                <asp:ListItem>Ms.</asp:ListItem>
                                                <asp:ListItem>Miss</asp:ListItem>
                                            </asp:DropDownList>
                                        </div>
                                        <div class="clr">
                                        </div>
                                    </div>
                                    <div class="name col-md-5">
                                        <label data-i18n="hotel-booking-fname">
                                            First Name<span class="redcol">*</span></label>
                                        <asp:TextBox ID="TextBoxFirstName" runat="server" Text="Enter First Name" data-i18n="[value]hotel-booking-errorfname" CssClass="CarSearchText alignleft"
                                            onfocus="placeholderOnFocus(this,'Enter First Name');" onblur="placeholderOnFocus(this,'Enter First Name');"></asp:TextBox>

                                        <asp:RequiredFieldValidator ID="rfvFirstName" runat="server" ControlToValidate="TextBoxFirstName"
                                            Display="Dynamic" ErrorMessage="Enter First Name" data-i18n="hotel-booking-errorfname" ValidationGroup="WebValidation"
                                            CssClass="rptErrorMassage" InitialValue="Enter First Name"></asp:RequiredFieldValidator>&nbsp;
                                    </div>
                                    <div class="name col-md-5">
                                        <label data-i18n="hotel-booking-lname">
                                            Last Name<span class="redcol">*</span></label>
                                        <asp:TextBox ID="TextBoxSurname" runat="server" Text="Enter Last Name" data-i18n="[value]hotel-booking-errorlname" CssClass="CarSearchText alignleft"
                                            onfocus="placeholderOnFocus(this,'Enter Last Name');" onblur="placeholderOnFocus(this,'Enter Last Name');"></asp:TextBox>

                                        <asp:RequiredFieldValidator ID="rfvLastName" runat="server" ControlToValidate="TextBoxSurname"
                                            Display="Dynamic" ErrorMessage="Enter Last Name" ValidationGroup="WebValidation"
                                            CssClass="rptErrorMassage" InitialValue="Enter Last Name" data-i18n="hotel-booking-errorlname"></asp:RequiredFieldValidator>&nbsp;
                                    </div>
                                    <div class="clr">
                                    </div>
                                </div>
                                <div class="mtop2 FL w100P textright ">
                                    <input id="chkHaveFlightNo" type="checkbox" value="Points" runat="server" />
                                    <span data-i18n="car-driverdetails-do"> Do you have Flight details at hand?</span>
                                </div>
                                <div id="DivFlightNumber" class="mtop2 w100P">
                                    <div class="name">
                                        <label data-i18n="car-driverdetails-flight">
                                            Flight Number<span class="redcol">*</span></label>
                                        <asp:TextBox ID="TextBoxFlightNumber" runat="server" CssClass="dropdwon_style ArialNarrow"></asp:TextBox>
                                    </div>
                                    <div class="clr">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12 text-right">
                                        <asp:Button ID="ImageButtonBookNow" runat="server" CssClass="blue_button" ValidationGroup="WebValidation"
                                            OnClick="ImageButtonBookNow_Click" Text="Proceed To Pay" data-i18n="[value]car-proceed-topay"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="innerBox ">
                        <div class="orderSum carBlk">
                            <div class="editbox">
                            <h3 data-i18n="flightpassenger-itinerary">Itinerary</h3>
                                <span class="edit"><a href="CarList.aspx?edit=1" data-i18n="car-details-edit">Edit</a> </span>
                           </div>
                                <div class="shopping-list">
                                <ul>
                                    <li>
                                        <div class="amt">
                                            <asp:Label runat="server" ID="lblCarName"></asp:Label>
                                        </div>
                                        <div class="clear">
                                        </div>
                                    </li>
                                    <li>
                                        <div class="txtC">
                                            <asp:Image runat="server" ID="imgCar" />
                                        </div>
                                    </li>
                                    <li class="bordertop">
                                        <div class="itenaryContent">
                                            <div class="item-Name">
                                                <asp:Label runat="server" ID="lblPickLocation"></asp:Label>
                                                <asp:Label runat="server" ID="lblPickCountry"></asp:Label>
                                            </div>
                                            <p>
                                                <asp:Label runat="server" ID="lblPickDateTime"></asp:Label>
                                            </p>
                                            <p>
                                                <asp:Label runat="server" ID="lblPickTime"></asp:Label>
                                            </p>
                                        </div>

                                        <div class="itenaryContent">
                                            <div class="item-Name">
                                                <asp:Label runat="server" ID="lblDropLocation"></asp:Label>
                                                <asp:Label runat="server" ID="lblDropCountry"></asp:Label>
                                            </div>
                                            <p>
                                                <asp:Label runat="server" ID="lblDropDateTime"></asp:Label>
                                            </p>
                                            <p>
                                                <asp:Label runat="server" ID="lblDropTime"></asp:Label>
                                            </p>
                                        </div>
                                        <div class="clear">
                                        </div>
                                    </li>
                                    <li>
                                        <div class="total-re ">
                                            <span class="amt">
                                                <asp:Label runat="server" ID="Title_Total"></asp:Label>
                                                <asp:Label runat="server" ID="Total_Value"></asp:Label>
                                            </span>
                                            <div class="clr">
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function placeholderOnFocus(obj, defaultVal) {
            if (obj.value == "") {
                obj.value = defaultVal;
            } else if (obj.value == defaultVal) {
                obj.value = "";
            } else { }
        };
        function BookNowTest() {

            var msg = "";
            $("#ErrorMsgContainer").hide();
            if ($("#CP_TextBoxFirstName").val().length == 0 || $("#CP_TextBoxFirstName").val() == "Enter First name") {
                msg = "Please Enter First name." + "<br/>";
            }
            else if ($("#CP_TextBoxSurname").val().length == 0 || $("#CP_TextBoxSurname").val() == "Enter Last name") {
                msg = "Please Enter Last name." + "<br/>";
            }

            if (msg.length > 0) {
                $("#LoginValidation")[0].innerHTML = msg;
                $("#CP_ErrorMsgContainer").show();
                return false;
            }
            else {
                e.preventDefault();
            }
        };
        function isValidEmailAddress(emailAddress) {
            var pattern = new RegExp(/^(("[\w-+\s]+")|([\w-+]+(?:\.[\w-+]+)*)|("[\w-+\s]+")([\w-+]+(?:\.[\w-+]+)*))(@((?:[\w-+]+\.)*\w[\w-+]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$)|(@\[?((25[0-5]\.|2[0-4][0-9]\.|1[0-9]{2}\.|[0-9]{1,2}\.))((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\.){2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[0-9]{1,2})\]?$)/i);
            return pattern.test(emailAddress);
        };
        $(document).ready(function () {
            $("#DivFlightNumber").hide();
            $("#CP_ErrorMsgContainer").hide();
            $("#CP_chkHaveFlightNo").click(function () {
                if (this.checked)
                    $("#DivFlightNumber").show();
                else
                    $("#DivFlightNumber").hide();
            });
            $("#CP_TextBoxFirstName").keydown(function (event) {
                if ((event.keyCode < 48 || event.keyCode > 57) && (event.keyCode < 96 || event.keyCode > 105)) {
                    return;
                }
                else
                    event.preventDefault();
            });
            $("#CP_TextBoxSurname").keydown(function (event) {
                if ((event.keyCode < 48 || event.keyCode > 57) && (event.keyCode < 96 || event.keyCode > 105)) {
                    return;
                }
                else
                    event.preventDefault();
            });
        });
    </script>
</asp:Content>
