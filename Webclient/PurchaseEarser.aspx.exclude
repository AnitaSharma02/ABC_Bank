                            <th>
                                <strong><span data-i18n="text-trans-eligible-cashback"></span></strong>
                            </th>
                            <th>
                                <strong><span data-i18n="text-transaction-currency"></span></strong>
                            </th>
                            <th>
                                <strong><span data-i18n="points-required"></span></strong>
                            </th>
                        </tr>
                        
                        <tr>
                            <td>
                                <span id="spanmerchantDetail"></span>
                            </td>
                            <td>
                                <span id="spanTransactionRef"></span>
                            </td>
                            <td>
                                <span id="spanTransactionAmount"></span>
                            </td>
                            <td>
                                <span id="spanTransactionCurrency"></span>
                            </td>
                            <td>
                                <span id="spanBillingAmount"></span>
                            </td>
                    </table>
                    <div class="text-center mt-3">
                        <a id="Back" href="javascript:void(0)" class="blue_button hvr-sweep-to-right" onclick="var varReturn=BacktoSummary();event.returnValue=varReturn; (event.preventDefault) ? event.preventDefault() : event.returnValue = false ;return varReturn;" alt="Back" data-i18n="btn-back">Back</a>
                        <a id="Continue" href="javascript:void(0)" class="blue_button hvr-sweep-to-right" onclick="var varReturn=TransactionErase();event.returnValue=varReturn; (event.preventDefault) ? event.preventDefault() : event.returnValue = false ;return varReturn;" alt="Continue" data-i18n="btn-continue">Continue</a>
                    </div>
                </div>
            </div>
            </div>
                </div>
        </div>
    </div>

    <script type="text/javascript">


        function GetTransactionDetail(id) {

            //alert(id);

            $.ajax({
                type: "POST",
                url: "PurchaseEarser.aspx/GetTransactionDetail",
                data: "{'lstrTransactionId':'" + id.toString() + "'}",
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("Oops! Something went wrong, please try again later.");
                },
                success: function (result) {

                    
                    $("#DivPurchaseEraserTranSummary").hide();
                    $("#DivTransactionDetails").show();

                    // alert("We returned: " + result.d);
                    if (result.d != "") {

                        if (result.d == "INSUFFICIENT_POINTS") {

                            alert("Insufficient Points.");
                            BacktoSummary();
                        }
                        else {

                            var data = $.parseJSON(result.d);

                            $("#spanmerchantDetail").text(data.MerchantName);
                            $("#spanTransactionRef").text(data.ExternalReference);
                            $("#spanTransactionAmount").text(data.Amounts);
                            $("#spanTransactionCurrency").text(data.TransactionCurrency);
                            $("#spanBillingAmount").text(data.AdditionalDetail);
                        }
                    }
                    else {
                        alert("Please try again.");
                    }
                }
            });

        };

        function BacktoSummary() {

            $("#DivPurchaseEraserTranSummary").show();
            $("#DivTransactionDetails").hide();

            $("#spanmerchantDetail").text('');
            $("#spanTransactionRef").text('');
            $("#spanTransactionAmount").text('');
            $("#spanTransactionCurrency").text('');
            $("#spanBillingAmount").text('');

        }

        function TransactionErase() {

            $.ajax({
                type: "POST",
                url: "PurchaseEarser.aspx/TransactionEraser",
                //data: "{'lstrTransactionId':'" + id.toString() + "'}",
                data: "",
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    alert("Oops! Something went wrong, please try again later.");
                },
                success: function (result) {

                    $("#DivPurchaseEraserTranSummary").hide();
                    $("#DivTransactionDetails").show();


                    if (result.d != "") {

                        if (result.d == "Failed") {

                            alert("transaction failed. Please try again.");
                            return false;
                        }
                        else {

                            location.href = "PurchaseEarser.aspx";

                            //BacktoSummary();
                            //$("#CP_lblerrorMessage").text("Transaction Erase Successfully.");
                        }
                    }
                    else {
                        alert("Please try again.");
                    }
                }
            });

        };

    </script>



</asp:Content>

