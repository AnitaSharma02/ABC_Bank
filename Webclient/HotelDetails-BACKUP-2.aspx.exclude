                              data-target="#dvAmenitiesModal"
                              class="btn btn-two mb-3">
                              View Amenities
                            </button>
                        </div>
                      </div>
                    
                    
                </div>                
                
                <div class="dvSelectRoom col-12">
                    <h2 class="h4 heading-regular text-colour7 bg-lightgray p-3">Select Your Room</h2>
                    <div id="rptRoomDetails" class="row mt-3"></div>
                </div>

                <div id="OverView" class="dvAboutHotel col-12 mt-3"></div>

            </div>

            <div class="row">
                <div class="col-12 d-none">
                    <div class="map" id="divGoogleMaps">
                        <img id="imgMap" alt="Map" class="w-100" />
                    </div>
                </div>
            </div>
                
            
            <div class="row pt-5">
                <div class="col-12 mb-3 text-center">
                    <h2 class="h2 heading-regular text-colour1">Similar Listing</h2>
                </div>
                <div id="NextHotelList" class="col-12">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="dvAmenitiesModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header py-2 align-items-center">
              <h2 class="h4 heading-semibold modal-title" id="DivAmenitiesCategoryName"></h2>
              <button type="button" class="close d-flex" data-dismiss="modal">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            <div class="modal-body pt-0">
                <div id="DivAmenities" class="row"></div>
            </div>
            <!-- <div class="modal-footer">
