    <div class="dvHotelDetails pb-5">
        <div class="container-lg">
            <div class="row">
                <div class="dvThumbSwiperSlider col-md-6 mb-3">
                    <div class="Hotelbanner" id="BannerImage">
                        <div id="divpre" class="btnPre purple-btn" data-i18n="hotel-details-prev">
                            Prev
                        </div>
                        <div id="divNext" class="btnNext purple-btn" data-i18n="hotel-details-next">
                            Next
                        </div>
                    </div>
                </div>
                <div class="dvHotelInfo col-md-6 mb-3">
                    <div class="row mb-3">
                        <div class="col-12">
                          <h2 id="HotelName" class="h1 heading-regular text-colour1"></h2>
                          <p>
                            <span id="HotelAddress"></span>
                            <span id="HotelCity"></span>
                          </p>
                          <p id="divrating"></p>
                        </div>
                    </div>
                    <div class="row mb-3" id="contact1">
                        <%--<div class="col-6 d-flex align-items-center">
                          <img src="images/icons/other/ico-phone.png" alt="" />
