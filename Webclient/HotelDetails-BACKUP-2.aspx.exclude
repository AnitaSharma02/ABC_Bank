                        </div>--%>
                      </div>
                    <div class="row mb-3" id="contact2">
                        <%--<div class="col-6 d-flex align-items-center">
                            <img src="images/icons/other/ico-phone.png" alt="" />
                            <span class="ml-2">91-11-27052700</span>
