<%@ Page Title="" Language="C#" MasterPageFile="~/SiteMaster.master" AutoEventWireup="true" CodeFile="PrepaidCard.aspx.cs" Inherits="PrepaidCard" %>

<asp:Content ID="Content1" ContentPlaceHolderID="CP" runat="Server">
   <style>
        .brd-crms {display:none;}
    </style>

    <script src="Jquery/PrepaidCard.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#divsubmit").hide();
            $("#lblselectedpoints").hide();
            $("#lblpoints").hide();

            $("#trQPostpoints").hide();
            $("#lblQPostpoints").hide();
            $("#lblselectedQPostpoints").hide();
            $("#lblTotalpoints").hide();
            $("#lblselectedTotalpoints").hide();

            $("#post").prop("checked", false).attr('disabled', true);
            $("#bpickup").prop("checked", false).attr('disabled', true);
            $("#delivarylblmessage").hide();
            $("#btn").hide();
            $("#label").hide();
            $("#divbtncontinue").hide();
            $("#delivarytd").hide();

        });

    </script>
    <div class="banner">
                <img src="../images/prepaid-banner.jpg" />
            </div>
    <div class="prepaidCard">
        <div id="divmain" class="container">
                <div class="loginBx">
                <h3 style="text-align: center;min-height: 350px;line-height: 350px; float: none!important; font-size: 24px;" data-i18n="text-coming-soon">Coming Soon!</h3>
                </div>
            <%--<div class="loginBx">
                <h1 data-i18n="text-prepaid--gift-card">Prepaid Card</h1>
                <p data-i18n="text-our-versatile">Our versatile Prepaid Gift Cards can be used to buy or shop anything you like for the value of the card.</p>
                <div class="shadow-sm innerbox">
                    <div id="divPrepaidCard">
                        <div class="text-center">
                            
                            <ul class="pcBlk">
                                <li class="selBox">
                                    <label data-i18n="text-card-value">Card Value:</label>
                                    <select id="ddlAmount" onchange="SelectHadyatiAmount(this.value)" class="form-control">
                                        <option selected="selected" value="0" data-i18n="input-text-select">Select</option>
                                        <option value="200">200 QR</option>
                                        <option value="500">500 QR</option>
                                        <option value="1000">1000 QR</option>
                                        <option value="3000">3000 QR</option>
                                        <option value="5000">5000 QR</option>
                                    </select>
                                </li>
                                <li id="delivarytd" class="mt-4">
                                    <label data-i18n="text-delivery-optioin">Delivery Options:</label>
                                    <div id="firstRadioButton">
                                        <input type="radio" name="delivery" id="bpickup" onclick="selectDeliveryOption(this.id)" style="vertical-align: middle;" />
                                        <span data-i18n="text-service-delivery-center">Service Delivery Center - C-Ring Road</span>
                                    </div>
                                    <div id="secondRadioButton">
                                        <input type="radio" name="delivery" id="post" onclick="selectDeliveryOption(this.id)" style="vertical-align: middle;" />
                                        <span data-i18n="text-qatar-post">Qatar Post</span>
                                    </div>
                                </li>
                                <li class="txtRight" style="display: none;">
                                    <p id="lblpoints" data-i18n="text-absher-points">Absher Points:</p>
                                    <label id="lblselectedpoints" />
                                </li>
                                <li id="trQPostpoints" class="txtRight" style="display: none;">
                                    <p id="lblQPostpoints" data-i18n="text-qatar-post-delivery-points">Qatar Post Delivery Points:</p>
                                    <label id="lblselectedQPostpoints" />
                                </li>
                                <li class="txtRight" style="display: none;">
                                    <p id="lblTotalpoints" data-i18n="text-total-absher-points">Total Absher Points:</p>
                                    <label id="lblselectedTotalpoints" />
                                </li>

                            </ul>

                            <div id="divlable" style="color: red; padding: 0 0 20px; text-align: center; display: none;">
                                <label id="lblmessage" />
                                <br />
                            </div>
                            <div id="divbtncontinue">
                                <button type="button" id="continuebtn" class="blue_button" onclick="onclickcontinue()" data-i18n="btn-continue">Continue</button>
                            </div>
                            <div id="delivarylbldiv">
                                <label id="delivarylblmessage" />
                            </div>
                        </div>
                    </div>
                    <div id="divConfirmation" runat="server">


                        <div id="divConfimationMessage" style="text-align: center;">
                            <label id="lblConfirmationMessage" />
                            <br />
                            <br />
                        </div>
                        <div class="chkboxtnc" id="ChkbBxtnc" style="display: none">
                            <div class="agreeCenter">
                                <input type="checkbox" id="chkAgreed" onclick="goFurther()">
                                <span data-i18n="text-agree">I agree to the</span> <a href="images/t&c.pdf" target="_blank"><span data-i18n="text-terms-conditions">Terms and Conditions</span></a>.
                            </div>
                        </div>


                        <div class="text-center">
                            <div id="btn" style="width: 100%; margin: 10px 0 0" class="chkboxdis">
                                <button type="button" id="btnback" onclick="onbackclick()" data-i18n="btn-back">Back</button>
                                <button type="button" id="submitbtn" onclick="onclicksubmit()" disabled data-i18n="btn-continue">Confirm</button>
                                <br />
                                <br />
                                <br />
                            </div>
                        </div>

                    </div>
                    <div id="divFinal" runat="server">
                        <div class="text-center">
                            <div id="divFinalMessage">
                                <label id="lblFinalMessage" />
                                <br />
                            </div>
                        </div>
                    </div>
                </div>
            </div>--%>
        </div>
    </div>
    <script type="text/javascript">
        function goFurther() {
            if (document.getElementById("chkAgreed").checked == true)
                document.getElementById("submitbtn").disabled = false;
            else
                document.getElementById("submitbtn").disabled = true;

        }
    </script>
</asp:Content>

