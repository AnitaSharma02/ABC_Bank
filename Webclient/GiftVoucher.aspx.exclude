                                                                    <div id="divBtnConfirm" runat="server">
                                                                        <asp:Button CssClass="buttonContainer" runat="server" ID="btnConfirm" Text="Confirm"
                                                                            CausesValidation="false" OnClick="btnConfirm_Click" />
                                                                    </div>
                                                                </div>
                                                                <div class="fl" style="margin-left: 15px;">
                                                                    <asp:Button CssClass="buttonContainer" runat="server" ID="Button2" Text="Back" OnClientClick="var retvalue = BackToDenomination(); event.returnValue= retvalue; return retvalue;"
                                                                        CausesValidation="false" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="width100 display_hide" id="divCreateVoucherSummary" runat="server">


                                                        <div class="width100">
                                                            <div class="width100 pb10">
                                                                Please find below the summary of QIBRewards REWARDS Gift Voucher:
                                                            </div>
                                                            <div class="Width99">
                                                                <asp:Repeater ID="RepCreateVoucherSummary" runat="server">
                                                                    <HeaderTemplate>
                                                                        <table width="100%" cellspacing="0" cellpadding="0" border="0" class="border_Voucher">
                                                                            <tr class="stylegridheader">
                                                                                <td>Sr. No
                                                                                </td>
                                                                                <td>Amount
                                                                                </td>
                                                                                <td>Status
                                                                                </td>
                                                                                <td>Voucher No
                                                                                </td>

                                                                            </tr>
                                                                    </HeaderTemplate>
                                                                    <ItemTemplate>
                                                                        <tr class="stylealternate1">
                                                                            <td align="center" valign="middle" height="25" class="borderTop_Voucher">
                                                                                <%# Container.ItemIndex + 1%>
                                                                            </td>
                                                                            <td align="center" valign="middle" class="borderTop_Voucher">
                                                                                <%# Eval("Amount","{0:0,0}")%>
                                                                            </td>
                                                                            <td align="center" valign="middle" class="borderTop_Voucher">
                                                                                <asp:Label ID="lblStatus" runat="server" Text='<%# (Boolean.Parse(Eval("Status").ToString())) ? "Successful" : "Failed"%>'></asp:Label>
                                                                            </td>
                                                                            <td align="center" valign="middle" class="borderTop_Voucher">
                                                                                <asp:Label ID="lblVoucherNo" runat="server" Text='<%# Eval("VoucherNo")%>'></asp:Label>
                                                                            </td>
                                                                        </tr>
                                                                    </ItemTemplate>
                                                                    <FooterTemplate>
                                                                        </table>
                                                        <asp:Label ID="lblErrorMsg" runat="server" CssClass="errMsg" Text="No Records Found."
                                                            Visible="false" />
                                                                    </FooterTemplate>
                                                                </asp:Repeater>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="width100 msgbxBG mTop20 display_hide" id="divConfirmationMsg" runat="server">
                                                        Dear Customer,<br />
                                                        <br />
                                                        Thank you, your transaction is successful. To see a record of all your Gift Voucher codes, simply click on <b>“My Account”</b> and scroll down to <b>“Voucher Summary”</b>
                                                        You may print your Gift Voucher codes and redeem at any of our participating partners.
                                                    </div>
                                                    <div class="width50 msgbxBG mTop20 display_hide" id="divCurrencyNotFound" runat="server">
                                                        Dear Customer,<br />
                                                        <br />
                                                        This currency does not supports Gift Voucher redemption.
                                                    </div>
                                                    <div class="width50 msgbxBG mTop20 display_hide" id="divAvailability" runat="server">
                                                        Dear Customer,<br />
                                                        <br />
                                                        You do not have sufficient points.<br />
                                                        <%--<a href="PurchasePoints.aspx">Click here </a>to purchase additional points.--%>
                                                    </div>
                                                </div>
                                            </ContentTemplate>
                                            <Triggers>
                                                <asp:AsyncPostBackTrigger ControlID="btnConfirm" EventName="Click" />
                                            </Triggers>
                                        </asp:UpdatePanel>
                                        <div class="Ourproduct_Rightpannel" id="Partnersdiv" style="display: none;">
                                            <div class="font20 fl width100 pTop10 pb10">
                                                <div id="partnerheading"></div>
                                            </div>
                                            <div class="RightInnerContent width100">
                                                <div class="width100 mTop10" id="partnerimagediv">
                                                </div>
                                                <div class="backVoucher" onclick="var retvalue = backtovoucherdiv(); event.returnValue= retvalue; return retvalue;"><span><< Go To Redeem Voucher</span></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="clr"></div>
