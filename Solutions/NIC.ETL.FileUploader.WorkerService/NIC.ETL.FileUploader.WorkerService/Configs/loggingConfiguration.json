{
  "AuditLog": {
    "Using": [ "Serilog.Sinks.Elasticsearch", "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\ETL\\Logs\\ServiceInvokerTrace.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 5000000,
          "rollOnFileSizeLimit": "true",
          //"outputTemplate": "[{Timestamp:u} {Level:u3}] {Message:lj}{NewLine}{Exception}{NewLine}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "ProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "ETL.FileUploader.WorkerService",
      "Environment": "UAT"
    }
  },
  "ErrorLog": {
    "Using": [ "Serilog.Sinks.Elasticsearch", "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "E:\\LBMS CORE\\SERVICES\\FILE SYSTEM WATCHER WORKER SERVICE\\WORKER PROCESSOR ROBOT\\Logs\\ServiceException.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 5000000,
          "rollOnFileSizeLimit": "true",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "ProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "WorkerService.FileSystemwatcher",
      "Environment": "UAT"
    }
  },
